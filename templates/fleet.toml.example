# fleet.toml — your supervision tree.
# The declarative list of worker sessions `fleet up` manages, modelled on an
# Erlang/OTP supervisor. Edit freely; `fleet up` reads it each time.

[supervisor]
# one_for_one: restarting one child does not touch the others (the usual choice).
# rest_for_one: restarting a child also restarts children listed after it.
strategy     = "one_for_one"
# restart intensity (circuit breaker): more than `max_restarts` restarts within
# `max_seconds` for a child trips the breaker — that child is marked `failed`
# and left down instead of crash-looping.
max_restarts = 3
max_seconds  = 60
# cap on agent-to-agent conversation depth (stops two agents ping-ponging
# forever). A reply inherits hop+1; sends past max_hops are refused.
max_hops     = 6

# --- children ---------------------------------------------------------------
# Each [[child]] is one worker session — typically one per repo in your
# workspace. List them in dependency order (foundational repos first); the tmux
# windows follow this order, with the supervisor first.
# `fleet up` starts an opposite-provider companion for each worker by default
# when that provider CLI is available. Use `fleet up --no-pairs` or
# FLEET_PAIR_ON_UP=off for single-agent startup.
#
#   id              stable name (also the tmux window name)
#   cwd             working dir, relative to the workspace root (or absolute)
#   restart         permanent | transient | temporary
#                     permanent = always restart on exit
#                     transient = restart only on abnormal (non-zero) exit
#                     temporary = never auto-restart
#   name            shown in the worker's prompt box (claude --name)
#   permission_mode default | acceptEdits | plan | bypassPermissions (optional)
#   provider        claude | codex (optional; default is claude or FLEET_AGENT_PROVIDER)
#   seed            initial prompt used ONLY on a fresh start; once a session
#                   exists, `fleet up` resumes it instead of re-seeding.

# Example: a shared library and two services that depend on it.

[[child]]
id      = "core"                 # a shared library the others depend on
cwd     = "core"
restart = "permanent"
name    = "core-worker"
seed    = "Resume work in core. Run 'git status' first and summarise where things stand."

[[child]]
id      = "api"                  # depends on core
cwd     = "api"
restart = "transient"
name    = "api-worker"
seed    = "Resume work in the api service. Run 'git status' first and summarise where things stand."

[[child]]
id      = "web"                  # depends on api
cwd     = "web"
restart = "transient"
name    = "web-worker"
seed    = "Resume work on the web frontend. Run 'git status' first and summarise where things stand."

# Optional: keep a standing different-model reviewer available.
# [[child]]
# id       = "core-reviewer"
# cwd      = "core"
# provider = "codex"
# restart  = "temporary"
# permission_mode = "plan"
# seed     = "Read-only adversarial review of current core changes. Find concrete failure modes."

# Replace the examples above with your repos.
#
# Tip: describe how these repos RELATE — who depends on whom, ownership/where
# changes belong — in <workspace>/.fleet/primer.md (see templates/primer.md.example).
# It's appended to every member's primer, so each agent knows to consult the right
# expert (e.g. a web change that needs an API change → `fleet ask api "..."`).
