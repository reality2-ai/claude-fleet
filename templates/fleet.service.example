# Claude fleet — per-user systemd unit for boot auto-start.
# Installed (rendered) to ~/.config/systemd/user/fleet.service by
# `fleet install-service`. With lingering enabled (loginctl enable-linger),
# the per-user manager starts at boot, so this brings the fleet up before any
# login and `fleet up` resumes every agent's recorded session.
[Unit]
Description=Claude fleet (__WORKSPACE__)
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=FLEET_WORKSPACE=__WORKSPACE__
# The user manager's PATH at boot is minimal; make sure `claude` is reachable.
# Adjust if your claude binary lives elsewhere, or set FLEET_CLAUDE_BIN below.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
#Environment=FLEET_CLAUDE_BIN=%h/.local/bin/claude
ExecStart=__FLEET_BIN__ up
ExecStop=__FLEET_BIN__ down
TimeoutStartSec=300

[Install]
WantedBy=default.target
