#!/usr/bin/env bash
# fleet — an OTP-style supervisor for parallel coding-agent sessions.
# See README.md. Subcommands: init status conflicts logs up down restart
# dispatch attach reap help version.
# resolve `# shellcheck source=` paths relative to this file's dir, not the CWD
# shellcheck source-path=SCRIPTDIR

set -euo pipefail

# --- require bash >= 4 (assoc arrays). macOS ships 3.2; tell the user clearly --
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  printf 'fleet: needs bash >= 4 (found %s).\n  macOS: brew install bash, and ensure it is first on PATH.\n' \
    "${BASH_VERSION:-unknown}" >&2
  exit 1
fi

# --- locate the tool (follow symlinks without GNU readlink -f) ---------------
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"; [ "${_src#/}" = "$_src" ] && _src="$_dir/$_src"
done
TOOL_ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
export TOOL_ROOT
# shellcheck source=../lib/common.sh
source "$TOOL_ROOT/lib/common.sh"
# shellcheck source=../lib/manifest.sh
source "$TOOL_ROOT/lib/manifest.sh"
# shellcheck source=../lib/githooks.sh
source "$TOOL_ROOT/lib/githooks.sh"
# shellcheck source=../lib/registry.sh
source "$TOOL_ROOT/lib/registry.sh"
# shellcheck source=../lib/provider.sh
source "$TOOL_ROOT/lib/provider.sh"
# shellcheck source=../lib/tmux.sh
source "$TOOL_ROOT/lib/tmux.sh"
# shellcheck source=../lib/restart.sh
source "$TOOL_ROOT/lib/restart.sh"
# shellcheck source=../lib/comms.sh
source "$TOOL_ROOT/lib/comms.sh"
# shellcheck source=../lib/transport.sh
source "$TOOL_ROOT/lib/transport.sh"
# shellcheck source=../lib/faculty.sh
source "$TOOL_ROOT/lib/faculty.sh"
# shellcheck source=../lib/faculty-bg.sh
source "$TOOL_ROOT/lib/faculty-bg.sh"
# shellcheck source=../lib/decisions.sh
source "$TOOL_ROOT/lib/decisions.sh"

FLEET_VERSION="0.1.0"

usage() {
  cat <<'EOF'
fleet — supervise parallel coding-agent sessions (OTP-style)

  fleet wizard [workspace] [owner]      interactive setup: pick gh repos to clone + run agents on
  fleet init [--no-hooks] [workspace]   scaffold .fleet/ and install self-reporting hooks
  fleet install-hooks [workspace]       install hooks into <ws>/.claude/settings.json
  fleet install-hooks --user            install hooks into ~/.claude/settings.json
                                          (covers hand-started sessions in sub-repos;
                                           no-ops outside a .fleet workspace)
  fleet install-git-hooks [--dry-run] [repo...]
                                        install repo-level Git hooks: pre-push
                                        publish guards + commit attribution
                                        into managed repos'
                                        .git/hooks/. Idempotent; a pre-existing hook is
                                        preserved as pre-push.local and still chained.
                                        NB installs from the RUNNING checkout's branch —
                                        check out the branch you mean to deploy first
                                        (the branch is printed on every run).
                                        `fleet doctor` hash-checks this for drift.
  fleet install-commands [<ws>|--user]  install the /fleet slash command
                                          (--user makes /fleet work in every session)
  fleet install-service         install a per-user systemd unit so the fleet
                                  auto-starts on boot + resumes  [systemd; needs linger]
  fleet status                  table of all known sessions (live/idle/dead, task, claims)
                                  (each workspace gets an isolated fleet automatically)
  fleet identity                show this workspace's fleet, socket, session, and service ids
  fleet brief                   triage: what needs you, who's waiting at their prompt, who's working
  fleet conflicts               files being edited by more than one live session
  fleet tasks [--json]          read the shared task ledger a lane is asked to cite into
  fleet logs [id]               tail the aggregate event log, or summarise one child

  fleet up [--no-supervisor] [--pairs] [id]
                                  start one writer per repo + one supervisor;
                                  --pairs opts into persistent read-only twins [needs tmux]
  fleet supervise [--pair]      start (or point you to) the supervisor session;
                                  --pair adds an opposite-provider warm standby
  fleet order                   arrange tmux windows: supervisor, then manifest order
  fleet down [id]               stop the suite (or one child), marked intentional
  fleet restart <id>            force-restart one child (honours intensity breaker)
  fleet dispatch [--provider claude|codex] <id> "<task>" [cwd]
                                  start a fresh worker seeded with a task
  fleet init-repo [id]           add missing AGENTS/DECISIONS/RESUME files and
                                  publish guards to one/all manifest repositories
  fleet init-resume [--force] [id] scaffold repo-local RESUME.md handoff file(s)
  fleet pair [--provider claude|codex] [--id companion-id] [id]
                                  start per-repo adversarial read-only twin(s)
  fleet pairs [id]               show logical Claude/Codex pairs and lane state
  fleet pair-send <id> "<msg>"   send one message to all live lanes in a pair
  fleet pair-ask <id> "<q>"      ask all live lanes in a pair off-thread
  fleet handoff [--provider claude|codex] [--stop-source] <from> [to-id]
                                  start an opposite-provider takeover from a
                                  source member's state, git context, and transcript tail
  fleet failover [--provider claude|codex] [--all|--exhausted] [id...]
                                  non-AI switch-over: stop source writer(s) and
                                  promote/start target-provider takeover(s)
  fleet refute [--provider claude|codex] [--id id] <target> [claim]
                                  start a read-only cross-model adversarial reviewer
  fleet attach <id>             attach your terminal to a child's tmux window
  fleet reap                    detect crashed children and apply restart policy
  fleet doctor [--quiet]        self-check state, mail, Git sync, and throttling

  fleet remote-control [on|off] [id]    enable/disable Claude /remote-control on member(s)
  fleet remote [id]             show remote-control status of member(s)

  fleet ask <to> "<question>"   consult a peer off-thread: a fork of its live
                                  context answers; reply → asker's inbox  [needs tmux]
  fleet send <to> "<msg>"       brief FYI into a peer's live thread (no reply)
  fleet send <to> --file <path> same, body read OUT OF BAND (use for anything
                               multi-line: the text never becomes a shell token,
                               so backticks/$(..)/$VAR cannot eat a clause silently)
  fleet broadcast "<msg>"       brief FYI to all peer agents
  fleet broadcast --file <path> same, body read out of band (--file - reads stdin)
  fleet inbox [id]              read a mailbox (full answers + audit trail)

  fleet decision add "<question>" [--for <agent>] [--options "a|b|c"] [--authority <who>]
                                  [--due <when>]
                                  record a decision waiting on you; prints its id
                                  --due takes "2026-08-08", "2026-08-08 17:00", "friday",
                                  "+2 days"; an unreadable date is REFUSED, never dropped.
                                  Lanes see "DUE <date> — <N> remaining" (or OVERDUE) in the
                                  decision context they receive, RECOMPUTED on every read —
                                  an agent has no clock and cannot notice a stale figure.
  fleet decision challenge <id> "<claim>"  wound confidence without changing the latch
  fleet decision revoke <id> "<reason>"    authority-only explicit invalidation
  fleet decide <id> "<answer>" [--due <when>]  ratify once; a different re-answer is refused
  fleet decisions [--all|--current] [--for <scope>] [--max N] [--json] [--watch]
                                  list open gates, history, or bounded active latches

  fleet help | version
EOF
}

# expand a selection like "1-3 5 all" into unique 1-based indices (<= max)
_wizard_expand() {
  local sel="$1" max="$2"; local -a out=(); local tok n
  for tok in $sel; do
    if [[ "$tok" == "all" ]]; then mapfile -t out < <(seq 1 "$max"); break
    elif [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      for (( n=BASH_REMATCH[1]; n<=BASH_REMATCH[2]; n++ )); do (( n>=1 && n<=max )) && out+=("$n"); done
    elif [[ "$tok" =~ ^[0-9]+$ ]]; then (( tok>=1 && tok<=max )) && out+=("$tok")
    fi
  done
  printf '%s\n' "${out[@]:-}" | awk 'NF && !seen[$0]++' | tr '\n' ' '
}

# write a manifest from a list of repo dir names (becomes the cwd + id)
_wizard_write_manifest() {
  local f="$1"; shift
  { printf '[supervisor]\nstrategy     = "one_for_one"\nmax_restarts = 3\nmax_seconds  = 60\nmax_hops     = 6\n\n'
    local name id
    for name in "$@"; do
      id="$(printf '%s' "$name" | tr -c 'a-zA-Z0-9_-' '-')"
      printf '[[child]]\nid      = "%s"\ncwd     = "%s"\nrestart = "transient"\nname    = "%s-worker"\nseed    = "Resume work in %s. Run '\''git status'\'' first and summarise where things stand."\n\n' \
        "$id" "$name" "$id" "$name"
    done
  } >"$f"
}

# Interactive setup: discover repos under a gh owner, choose which to bring local
# and which to run agents on, then scaffold the workspace.
cmd_wizard() {
  command -v gh >/dev/null 2>&1 || die "fleet wizard needs the GitHub CLI (gh): https://cli.github.com  then 'gh auth login'"
  gh auth status >/dev/null 2>&1 || die "not logged in to GitHub — run: gh auth login"
  fleet_require_jq

  local ws="${1:-$PWD}"; ws="$(fleet_realpath "$ws")"
  mkdir -p "$ws"
  info "Workspace: $ws"

  local owner="${2:-}"
  if [[ -z "$owner" ]]; then
    local me; me="$(gh api user -q .login 2>/dev/null || true)"
    read -rp "GitHub owner/org to scan [${me:-}]: " owner; owner="${owner:-$me}"
  fi
  [[ -n "$owner" ]] || die "no owner given"

  info "Fetching repos under '$owner'…"
  local -a repos=()
  mapfile -t repos < <(gh repo list "$owner" --no-archived --limit 300 \
    --json name,description,pushedAt,isPrivate,primaryLanguage \
    -q 'sort_by(.pushedAt)|reverse|.[]|[.name,(if .isPrivate then "private" else "public" end),(.primaryLanguage.name//"-"),((.description//"")[0:48])]|@tsv' 2>/dev/null)
  [[ ${#repos[@]} -gt 0 ]] || die "no repos found under '$owner' (or no access)"

  local i=1 r name vis lang desc mark
  printf '\n%s   #  loc  %-24s %-7s %-8s %s%s\n' "$c_bold" "REPO" "VIS" "LANG" "DESC" "$c_reset"
  for r in "${repos[@]}"; do
    IFS=$'\t' read -r name vis lang desc <<<"$r"
    mark=" "; [[ -d "$ws/$name" ]] && mark="✓"
    printf '  %2d   [%s] %-24s %-7s %-8s %s\n' "$i" "$mark" "$name" "$vis" "$lang" "$desc"
    i=$(( i+1 ))
  done
  info "  ([✓] = already cloned in the workspace)"

  local sel; read -rp $'\nWhich repos make up this workspace? (e.g. 1-3 5, or all): ' sel
  local -a chosen=(); read -ra chosen <<<"$(_wizard_expand "$sel" "${#repos[@]}")"
  [[ ${#chosen[@]} -gt 0 ]] || die "nothing selected"

  # clone the missing ones
  local idx; for idx in "${chosen[@]}"; do
    name="$(cut -f1 <<<"${repos[$((idx-1))]}")"
    if [[ -d "$ws/$name" ]]; then info "  have   $name"
    else
      local yn; read -rp "  clone $owner/$name into the workspace? [Y/n] " yn
      [[ "$yn" =~ ^[Nn] ]] || { info "  cloning $name…"; if gh repo clone "$owner/$name" "$ws/$name" >/dev/null 2>&1; then info "  cloned $name"; else warn "  clone failed: $name"; fi; }
    fi
  done

  # which get an agent
  local asel; read -rp $'\nWhich of those should run an AI agent (a fleet member)?\n(subset, in DEPENDENCY order — foundational first; same number format): ' asel
  local -a agents=(); read -ra agents <<<"$(_wizard_expand "$asel" "${#repos[@]}")"
  [[ ${#agents[@]} -gt 0 ]] || die "no agents selected"
  local -a agent_names=(); for idx in "${agents[@]}"; do agent_names+=("$(cut -f1 <<<"${repos[$((idx-1))]}")"); done

  # scaffold
  mkdir -p "$ws/.fleet"
  _wizard_write_manifest "$ws/.fleet/fleet.toml" "${agent_names[@]}"
  info ""
  info "Wrote manifest with ${#agent_names[@]} member(s): ${agent_names[*]}"
  cmd_init "$ws"          # scaffold dirs + .gitignore + hooks (keeps the manifest above)
  FLEET_WORKSPACE="$ws" cmd_init_repo

  info ""
  info "Next:"
  info "  1. Complete each AGENTS.md repository map; TODO(fleet-onboarding) is a hold."
  info "  2. Fill each RESUME.md, then install tmux if needed: cd $ws && fleet up"
}

# ----------------------------------------------------------------------------
cmd_init() {
  local no_hooks=0
  local hooks_provider="${FLEET_INIT_PROVIDER:-claude}"
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --no-hooks) no_hooks=1; shift ;;
      --provider) hooks_provider="${2:?usage: fleet init [--provider claude|codex|all] [--no-hooks] [workspace]}"; shift 2 ;;
      --claude) hooks_provider="claude"; shift ;;
      --codex) hooks_provider="codex"; shift ;;
      --all) hooks_provider="all"; shift ;;
      *) break ;;
    esac
  done
  local ws="${1:-$PWD}"
  ws="$(fleet_realpath "$ws")"
  [[ -d "$ws" ]] || die "workspace does not exist: $ws"
  local sd="$ws/.fleet"
  mkdir -p "$sd/state" "$sd/run" "$sd/log"

  if [[ -f "$sd/fleet.toml" ]]; then
    info "kept existing $sd/fleet.toml"
  else
    cp "$TOOL_ROOT/templates/fleet.toml.example" "$sd/fleet.toml"
    info "wrote   $sd/fleet.toml  (edit this — it is your supervision tree)"
  fi

  # a .gitignore so you can version your config (fleet.toml, primer.md) in a repo
  # for portability across machines, while runtime state stays local.
  if [[ ! -f "$sd/.gitignore" ]]; then
    cat >"$sd/.gitignore" <<'GI'
# claude-fleet runtime state — machine-specific and regenerated.
# Only the config (fleet.toml, primer.md) is meant to be versioned.
/state/
/run/
/log/
/inbox/
/spill/
/managed.settings.json
*.lock
*.tmp
*.tmp.*
GI
    info "wrote   $sd/.gitignore (so you can 'git init' here and version your config)"
  fi

  # merge hooks + install the /fleet command into the workspace .claude/
  if [[ "$no_hooks" == "1" ]]; then
    info "skipped hooks + /fleet command (--no-hooks). Install later:"
    info "  fleet install-hooks $ws   and   fleet install-commands $ws"
  else
    fleet_install_hooks_for_provider "$hooks_provider" "$ws"
    fleet_install_commands "$ws"
  fi
  info ""
  info "Done. Next: 'fleet status' (works now), and for lifecycle install tmux then 'fleet up'."
  FLEET_WORKSPACE="$ws" fleet_load_paths
  fleet_log init "-" "workspace=$ws"
}

# Merge the self-reporting hooks into an arbitrary settings.json (idempotent).
_merge_hooks_into() {
  local settings="$1"; mkdir -p "$(dirname "$settings")"
  local hooks_json; hooks_json="$(_render_hooks_json)"
  if [[ -f "$settings" ]]; then
    local merged; merged="$(jq --argjson h "$hooks_json" '.hooks = ((.hooks // {}) * $h)' "$settings")"
    printf '%s\n' "$merged" >"$settings"
    info "merged self-reporting hooks into $settings"
  else
    jq -n --argjson h "$hooks_json" '{hooks: $h}' >"$settings"
    info "wrote   $settings  (self-reporting hooks)"
  fi
}

_render_codex_hooks_json() {
  local h="$TOOL_ROOT/hooks"
  jq -n --arg h "$h" '
    def hk(script): [ { hooks: [ { type: "command", command: ($h + "/" + script) } ] } ];
    def hke(event; script): [ { hooks: [ { type: "command", command: ("FLEET_HOOK_EVENT=" + event + " " + $h + "/" + script) } ] } ];
    def hkm(matcher; script): [ { matcher: matcher, hooks: [ { type: "command", command: ($h + "/" + script) } ] } ];
    def hkme(event; matcher; script): [ { matcher: matcher, hooks: [ { type: "command", command: ("FLEET_HOOK_EVENT=" + event + " " + $h + "/" + script) } ] } ];
    {
      SessionStart:      [ { matcher: "startup|resume", hooks: [ { type: "command", command: ($h + "/session-start.sh") } ] } ],
      UserPromptSubmit:  hk("prompt-submit.sh"),
      PermissionRequest: hkme("PermissionRequest"; "Bash|apply_patch|Edit|Write|MultiEdit|NotebookEdit"; "auto-approve.sh"),
      PostToolUse:       hkm("Bash|apply_patch|Edit|Write|MultiEdit|NotebookEdit"; "post-edit.sh"),
      Stop:              hk("on-stop.sh")
    }'
}

_merge_codex_hooks_into() {
  local hooks_file="$1"; mkdir -p "$(dirname "$hooks_file")"
  local hooks_json; hooks_json="$(_render_codex_hooks_json)"
  if [[ -f "$hooks_file" ]]; then
    local merged; merged="$(jq --argjson h "$hooks_json" '.hooks = ((.hooks // {}) * $h)' "$hooks_file")"
    printf '%s\n' "$merged" >"$hooks_file"
    info "merged self-reporting hooks into $hooks_file"
  else
    jq -n --argjson h "$hooks_json" '{hooks: $h}' >"$hooks_file"
    info "wrote   $hooks_file  (self-reporting hooks)"
  fi
}

# Project-scoped install (one workspace's sessions started at its root).
fleet_install_hooks() { _merge_hooks_into "$(fleet_realpath "$1")/.claude/settings.json"; }
fleet_install_codex_hooks() { _merge_codex_hooks_into "$(fleet_realpath "$1")/.codex/hooks.json"; }

# User-scoped install (every session, anywhere — the hooks no-op outside a
# .fleet workspace, so this is safe globally). Covers hand-started sessions in
# sub-repos that don't inherit the workspace-root settings.
fleet_install_user_hooks() { _merge_hooks_into "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"; }
fleet_install_user_codex_hooks() { _merge_codex_hooks_into "${CODEX_HOME:-$HOME/.codex}/hooks.json"; }

fleet_install_hooks_for_provider() {
  local provider="$1" ws="${2:-$PWD}"
  case "$provider" in
    claude) fleet_install_hooks "$ws" ;;
    codex)  fleet_install_codex_hooks "$ws" ;;
    all)    fleet_install_hooks "$ws"; fleet_install_codex_hooks "$ws" ;;
    *) die "unknown provider '$provider' (expected claude, codex, or all)" ;;
  esac
}

fleet_install_user_hooks_for_provider() {
  local provider="$1"
  case "$provider" in
    claude) fleet_install_user_hooks ;;
    codex)  fleet_install_user_codex_hooks ;;
    all)    fleet_install_user_hooks; fleet_install_user_codex_hooks ;;
    *) die "unknown provider '$provider' (expected claude, codex, or all)" ;;
  esac
}

# Install the /fleet slash command into a .claude/commands dir.
_install_command_to() {
  local cdir="$1"; mkdir -p "$cdir/commands"
  cp "$TOOL_ROOT/commands/fleet.md" "$cdir/commands/fleet.md"
  info "wrote   $cdir/commands/fleet.md  (use /fleet in sessions there)"
}
fleet_install_commands()      { _install_command_to "$(fleet_realpath "$1")/.claude"; }
fleet_install_user_commands() { _install_command_to "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; }

# Write a settings file carrying only the hooks, for --settings injection into
# managed workers so they self-report regardless of their cwd/project.
fleet_ensure_managed_settings() {
  MANAGED_SETTINGS="$STATE_DIR/managed.settings.json"
  jq -n --argjson h "$(_render_hooks_json)" '{hooks: $h}' >"$MANAGED_SETTINGS"
  export MANAGED_SETTINGS
}

# emit the hooks object that points at this checkout's hook scripts
_render_hooks_json() {
  local h="$TOOL_ROOT/hooks"
  jq -n --arg h "$h" '
    def hk(script): [ { hooks: [ { type: "command", command: ($h + "/" + script) } ] } ];
    def hkm(matcher; script): [ { matcher: matcher, hooks: [ { type: "command", command: ($h + "/" + script) } ] } ];
    {
      SessionStart:      hk("session-start.sh"),
      UserPromptSubmit:  hk("prompt-submit.sh"),
      PreToolUse:        hk("auto-approve.sh"),
      # Two PostToolUse groups: post-edit records touched files; output-budget spills a
      # fat result to disk and leaves head+tail inline. Claude only — the budget hook
      # replies with `updatedToolOutput`, which is a Claude Code hook contract; codex has
      # no verified equivalent and MUST NOT be handed a reply shape it may not honour.
      PostToolUse:       hkm("Edit|Write|MultiEdit|NotebookEdit"; "post-edit.sh")
                       + hkm("Bash|Grep|Glob"; "output-budget.sh"),
      Stop:              hk("on-stop.sh"),
      SessionEnd:        hk("session-end.sh")
    }'
}

# ----------------------------------------------------------------------------
cmd_identity() {
  fleet_load_paths
  printf 'workspace=%s\nid=%s\nsocket=%s\nsession=%s\nservice=%s\n' \
    "$WORKSPACE" "$FLEET_WORKSPACE_ID" "$FLEET_TMUX_SOCKET" \
    "$FLEET_TMUX_SESSION" "$FLEET_SERVICE_NAME"
}

cmd_status() {
  fleet_load_paths
  [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"

  # Re-derive the registry from ground truth FIRST, so a child with a deleted
  # state doc but a live window is recreated before we enumerate (idempotent,
  # creates-only, read-only on tmux). FLEET_RECONCILE=off restores old behaviour.
  fleet_reconcile

  # union of manifest ids and ids that have state on disk
  local -A seen=(); local -a ids=()
  local id
  for id in "${CHILD_IDS[@]:-}"; do [[ -n "$id" ]] || continue; seen["$id"]=1; ids+=("$id"); done
  while read -r id; do [[ -n "$id" && -z "${seen[$id]:-}" ]] && { seen["$id"]=1; ids+=("$id"); }; done < <(fleet_state_ids)

  if [[ ${#ids[@]} -eq 0 ]]; then
    info "no sessions known yet. Start an agent session in this workspace, or 'fleet up'."
    return
  fi

  # manifest membership → "managed" even before a child has started
  local -A MAN=(); for id in "${CHILD_IDS[@]:-}"; do [[ -n "$id" ]] && MAN["$id"]=1; done

  _conflict_set   # populates CONFLICT_PATHS assoc array

  printf '%s%-14s %-7s %-10s %-9s %-7s %-5s %-3s %s%s\n' "$c_bold" \
    "CHILD" "STATE" "MANAGED" "SESSION" "ACTIVE" "CLAIMS" "WIN" "TASK" "$c_reset"
  for id in "${ids[@]}"; do
    local live managed sid ago claims win mark task color
    live="$(faculty_liveness "$id")"
    managed="$(fleet_state_get "$id" '.managed' false)"
    if [[ -n "${MAN[$id]:-}" || "$managed" == "true" ]]; then managed="managed"; else managed="ad-hoc"; fi
    sid="$(fleet_state_get "$id" '.session_id' "")"; sid="${sid:0:8}"; [[ -z "$sid" ]] && sid="-"
    ago="$(fleet_ago "$(fleet_last_activity "$id")")"
    claims="$(fleet_state_get "$id" '.claims | length' 0)"
    win="-"; fleet_tmux_has_window "$id" 2>/dev/null && win="y"
    task="$(fleet_state_get "$id" '.current_task' "")"; task="${task:0:48}"
    mark=" "; _child_has_conflict "$id" && mark="⚠"
    case "$live" in
      live)   color="$c_grn" ;;
      idle)   color="$c_yel" ;;
      dead)   color="$c_dim" ;;
      failed) color="$c_red" ;;
      *)      color="$c_dim" ;;
    esac
    printf '%s%-14s %-7s%s %-10s %-9s %-7s %-5s %-3s %s %s\n' \
      "$color" "$id" "$live" "$c_reset" "$managed" "$sid" "$ago" "$claims" "$win" "$mark" "$task"
  done
}

# Build CONFLICT_PATHS[path]="id1 id2 ..." across LIVE/IDLE children only.
declare -gA CONFLICT_PATHS=()
declare -gA CHILD_CONFLICT=()
_conflict_set() {
  CONFLICT_PATHS=(); CHILD_CONFLICT=()
  local -A pathmap=()
  local id live p
  while read -r id; do
    [[ -n "$id" ]] || continue
    live="$(faculty_liveness "$id")"
    [[ "$live" == "dead" || "$live" == "stopped" || "$live" == "failed" ]] && continue
    while read -r p; do
      [[ -n "$p" ]] || continue
      pathmap["$p"]="${pathmap[$p]:-} $id"
    done < <(fleet_state_get "$id" '.claims[]' "" 2>/dev/null)
  done < <(fleet_state_ids)
  for p in "${!pathmap[@]}"; do
    # unique ids
    local -a uids; read -ra uids <<<"${pathmap[$p]}"
    local u; u="$(printf '%s\n' "${uids[@]}" | sort -u | tr '\n' ' ')"
    if [[ "$(wc -w <<<"$u")" -gt 1 ]]; then
      CONFLICT_PATHS["$p"]="$u"
      local cid; for cid in $u; do CHILD_CONFLICT["$cid"]=1; done
    fi
  done
}
_child_has_conflict() { [[ -n "${CHILD_CONFLICT[$1]:-}" ]]; }

# fleet tasks — READ the shared task ledger (#118).
#
# Lanes are routinely asked to cite findings into this ledger ("that is #115(b)",
# "filed as #121") and until now had NO command to read it. Citation ran one way:
# the supervisor could write an id, and the lane it was addressed to could not look
# up what the id said. A cite into a ledger the recipient cannot open is opaque.
#
# The ledger itself lives in the supervisor's session, not on disk, so this command
# reads an EXPORT the supervisor writes to $STATE_DIR/tasks.json. That keeps the
# supervisor the single writer — which is the property that makes an id stable and
# therefore worth citing — while giving every lane a read path.
#
# DELIBERATELY MINIMAL, and all six lanes backed this shape: a full dump, read-only,
# no filter flags, no search, no lane-side write. A lane that can read the ledger can
# grep it. Every filter flag would be one more thing that can silently return a wrong
# subset, which is the exact defect class this fleet spent 2026-07-19/20 chasing —
# and a filter that returns nothing is indistinguishable from a ledger with nothing
# in it, the zero-denominator problem in a new place.
#
# STALENESS IS REPORTED, NEVER HIDDEN. The export is a snapshot; if it is missing or
# old, this says so rather than printing an empty list. An absent file that reads as
# "no tasks" is the absent-file-passes-every-must-be-0-check defect, and it would land
# here first.
cmd_tasks() {
  fleet_load_paths
  local json=0
  [[ "${1:-}" == "--json" ]] && json=1
  local f="$STATE_DIR/tasks.json"

  if [[ ! -f "$f" ]]; then
    # NOT an empty ledger — an ABSENT export. Say which, on stderr, and fail.
    warn "no task ledger export at $f"
    warn "the ledger lives in the supervisor's session; ask it to run 'fleet tasks-export'."
    warn "this is NOT 'zero tasks' — it is 'no snapshot has been written'."
    return 1
  fi

  # A stale snapshot is still readable, but the reader MUST be told its age, so a
  # cite resolved against it can be graded. Currency is a separate axis from content:
  # a correct-looking answer from a three-day-old export is the failure mode.
  local age_s="" stamp=""
  stamp="$(jq -r '.exported_at // empty' "$f" 2>/dev/null || true)"
  if [[ -n "$stamp" ]]; then
    local now epoch
    now="$(date +%s)"; epoch="$(date -d "$stamp" +%s 2>/dev/null || echo "")"
    [[ -n "$epoch" ]] && age_s=$(( now - epoch ))
  fi

  if (( json )); then
    cat "$f"
    [[ -n "$age_s" ]] && (( age_s > 86400 )) && \
      warn "export is $(( age_s / 3600 ))h old (exported_at $stamp) — verify before citing it"
    return 0
  fi

  local n
  n="$(jq -r '.tasks | length' "$f" 2>/dev/null || echo 0)"
  printf '%stask ledger%s — %s task(s)' "$c_bold" "$c_reset" "$n"
  [[ -n "$stamp" ]] && printf ', exported %s' "$stamp"
  printf '\n\n'
  jq -r '.tasks[] | "  #\(.id)\t[\(.status)]\t\(.title)"' "$f" 2>/dev/null \
    | column -t -s $'\t' 2>/dev/null || jq -r '.tasks[] | "  #\(.id) [\(.status)] \(.title)"' "$f"
  if [[ -n "$age_s" ]] && (( age_s > 86400 )); then
    printf '\n'; warn "export is $(( age_s / 3600 ))h old — verify against the supervisor before citing it"
  fi
}

cmd_conflicts() {
  fleet_load_paths
  _conflict_set
  if [[ ${#CONFLICT_PATHS[@]} -eq 0 ]]; then
    info "no conflicts: no file is claimed by more than one live session."
    return
  fi
  warn "${#CONFLICT_PATHS[@]} file(s) claimed by multiple live sessions:"
  local p
  for p in "${!CONFLICT_PATHS[@]}"; do
    printf '  %s%s%s\n      ↳ %s\n' "$c_yel" "$p" "$c_reset" "${CONFLICT_PATHS[$p]# }"
  done
}

# count of undelivered (unanswered) messages in a member's mailbox
_undelivered_count() {
  local f; f="$(fleet_inbox_file "$1")" || { echo 0; return; }
  [[ -f "$f" ]] || { echo 0; return; }
  jq -s '[.[]|select(.delivered==false)]|length' "$f" 2>/dev/null || echo 0
}

# the last thing a member said (last assistant text from its transcript), collapsed
_last_said() {
  local id="$1" cwd sid provider tf txt
  cwd="$(fleet_state_get "$id" '.cwd' "")"; sid="$(fleet_state_get "$id" '.session_id' "")"
  provider="$(fleet_state_get "$id" '.provider' claude)"
  [[ -n "$cwd" && -n "$sid" ]] || return 0
  tf="$(fleet_transcript_path "$cwd" "$sid" "$provider")"; [[ -f "$tf" ]] || return 0
  txt="$(tail -n 3000 "$tf" 2>/dev/null \
    | jq -rc 'select(.type=="assistant") | (.message.content // []) | map(select(.type=="text")|.text)[]' 2>/dev/null \
    | tail -1 || true)"
  printf '%s' "$txt" | tr '\n' ' ' | sed 's/  */ /g'
  return 0
}

# Human-oriented triage: what needs you, who's waiting at their prompt, who's working.
cmd_brief() {
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  _conflict_set
  local -A MAN=(); local id; for id in "${CHILD_IDS[@]:-}"; do [[ -n "$id" ]] && MAN["$id"]=1; done
  local -A seen=(); local -a ids=()
  for id in "${CHILD_IDS[@]:-}"; do [[ -n "$id" && -z "${seen[$id]:-}" ]] && { seen[$id]=1; ids+=("$id"); }; done
  while read -r id; do [[ -n "$id" && -z "${seen[$id]:-}" ]] && { seen[$id]=1; ids+=("$id"); }; done < <(fleet_state_ids)

  local -a attention=() waiting=() working=()
  local live ready mail snip managed provider
  for id in "${ids[@]}"; do
    fleet_is_supervisor_id "$id" && continue                 # overseer lanes aren't triaged
    managed="$(fleet_state_get "$id" '.managed' false)"
    [[ -n "${MAN[$id]:-}" || "$managed" == "true" ]] || continue
    if fleet_pane_is_provider_exhausted "$id" 2>/dev/null; then
      provider="$(_fleet_id_provider "$id")"
      attention+=("$id — $provider usage/credits exhausted · use 'fleet handoff $id --stop-source' or request more provider usage")
      continue
    fi
    live="$(faculty_liveness "$id")"; ready="$(fleet_state_get "$id" '.ready' false)"
    mail="$(_undelivered_count "$id")"
    case "$live" in
      failed)  attention+=("$id — FAILED (restart breaker tripped) · see 'fleet logs $id'") ;;
      dead)    attention+=("$id — dead (no live window / no recent activity)") ;;
      stopped) : ;;
      *)
        if [[ "$ready" == "true" || "$live" == "idle" ]]; then
          snip="$(_last_said "$id")"; snip="${snip: -220}"
          waiting+=("$id │ last said: ${snip:-<no text yet>}")
        else
          working+=("$id │ $(fleet_state_get "$id" '.current_task' '(working)' | cut -c1-72)")
        fi ;;
    esac
    [[ "${mail:-0}" -gt 0 ]] && attention+=("$id — $mail unanswered peer message(s) · 'fleet inbox $id'")
  done
  # only surface conflicts between MANAGED members (ignore ad-hoc/driving sessions)
  local -a confs=(); local p o mgr
  for p in "${!CONFLICT_PATHS[@]}"; do
    mgr=""
    for o in ${CONFLICT_PATHS[$p]}; do
      [[ -n "${MAN[$o]:-}" || "$(fleet_state_get "$o" '.managed' false)" == "true" ]] && mgr+=" $o"
    done
    [[ "$(wc -w <<<"$mgr")" -ge 2 ]] && confs+=("${p##*/} —$mgr")
  done

  printf '%s═══ fleet brief ═══%s\n' "$c_bold" "$c_reset"
  if (( ${#attention[@]} || ${#confs[@]} )); then
    printf '\n%s▲ NEEDS YOU%s\n' "$c_red" "$c_reset"
    for p in "${attention[@]}"; do printf '   • %s\n' "$p"; done
    for p in "${confs[@]}"; do printf '   • conflict on %s\n' "$p"; done
  fi
  if (( ${#waiting[@]} )); then
    printf '\n%s◆ WAITING AT THEIR PROMPT%s  (may want your input)\n' "$c_yel" "$c_reset"
    for p in "${waiting[@]}"; do printf '   • %s\n' "$p"; done
  fi
  if (( ${#working[@]} )); then
    printf '\n%s● WORKING%s  (no action needed)\n' "$c_grn" "$c_reset"
    for p in "${working[@]}"; do printf '   • %s\n' "$p"; done
  fi
  # One bounded control-plane view replaces a permanently running decisions
  # pane. This is generated from records, never copied from agent prose.
  local decision_json decision_count=0 decision_open_count=0
  decision_json="$(_fleet_decisions_current_json "" "${FLEET_BRIEF_DECISIONS_MAX:-8}" 2>/dev/null || printf '[]')"
  decision_count="$(printf '%s' "$decision_json" | jq -r 'length' 2>/dev/null || echo 0)"
  [[ "$decision_count" =~ ^[0-9]+$ ]] || decision_count=0
  decision_open_count="$(printf '%s' "$decision_json" | jq -r '[.[] | select((.state // .latch_state // .status // "open")=="open")] | length' 2>/dev/null || echo 0)"
  [[ "$decision_open_count" =~ ^[0-9]+$ ]] || decision_open_count=0
  if (( decision_count > 0 )); then
    printf '\n%s◆ AUTHORITATIVE DECISIONS%s  (bounded current view)\n' "$c_bold" "$c_reset"
    _fleet_decisions_current_print "" "${FLEET_BRIEF_DECISIONS_MAX:-8}" 0 | sed 's/^/   /'
  fi
  (( ${#attention[@]} || ${#confs[@]} || ${#waiting[@]} || decision_open_count )) \
    || printf '\n  All members are working or quiet — nothing waiting on you.\n'
}

# ----------------------------------------------------------------------------
cmd_logs() {
  fleet_load_paths
  local id="${1:-}"
  if [[ -z "$id" ]]; then
    [[ -f "$LOG_FILE" ]] || { info "(no events logged yet)"; return; }
    tail -n 40 "$LOG_FILE"
    return
  fi
  local cwd sid provider t
  cwd="$(fleet_state_get "$id" '.cwd' "")"; sid="$(fleet_state_get "$id" '.session_id' "")"
  provider="$(fleet_state_get "$id" '.provider' claude)"
  info "child:        $id"
  info "state:        $(faculty_liveness "$id")"
  info "session:      ${sid:-<none>}"
  info "cwd:          ${cwd:-<unknown>}"
  info "current task: $(fleet_state_get "$id" '.current_task' '<none>')"
  info "claims:       $(fleet_state_get "$id" '.claims | length' 0) file(s)"
  t="$(fleet_transcript_path "$cwd" "$sid" "$provider")"
  [[ -f "$t" ]] && info "transcript:   $t ($(fleet_ago "$(fleet_mtime "$t")") ago)"
}

# ----------------------------------------------------------------------------
# Arrange the tmux windows into the canonical order: supervisor first, then the
# children in manifest (dependency) order, then anything else (ad-hoc, ask:*).
# Done by parking every window at a high temp index, then placing back at 0..n-1.
fleet_reorder_windows() {
  fleet_tmux_session_exists || return 0
  local -a current=(); mapfile -t current < <(fleet_tmux list-windows -t "$FLEET_TMUX_SESSION" -F '#W' 2>/dev/null)
  [[ ${#current[@]} -eq 0 ]] && return 0
  local -a want=(supervisor supervisor-codex) desired=(); local -A seen=(); local w id
  for id in "${CHILD_IDS[@]:-}"; do [[ -n "$id" ]] && want+=("$id"); done
  for w in "${want[@]}"; do
    printf '%s\n' "${current[@]}" | grep -qxF -- "$w" && { desired+=("$w"); seen["$w"]=1; }
  done
  for w in "${current[@]}"; do [[ -z "${seen[$w]:-}" ]] && desired+=("$w"); done
  local i=0
  for w in "${desired[@]}"; do fleet_tmux move-window -d -s "$FLEET_TMUX_SESSION:$w" -t "$FLEET_TMUX_SESSION:$((900+i))" 2>/dev/null; i=$(( i+1 )); done
  i=0
  for w in "${desired[@]}"; do fleet_tmux move-window -d -s "$FLEET_TMUX_SESSION:$((900+i))" -t "$FLEET_TMUX_SESSION:$i" 2>/dev/null; i=$(( i+1 )); done
}

cmd_order() {
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_has_tmux || die "tmux required for window ordering."
  fleet_reorder_windows
  info "windows ordered: $(fleet_tmux list-windows -t "$FLEET_TMUX_SESSION" -F '#{window_index}:#W' 2>/dev/null | tr '\n' ' ')"
}

# Launch the supervisor: an interactive agent session, primed with the
# supervisor role, that oversees the fleet and can message workers. It is a
# first-class fleet member (window "supervisor", id "supervisor").
fleet_start_supervisor() {
  fleet_tmux_has_window supervisor && return 0
  fleet_ensure_managed_settings
  fleet_tmux_ensure_session
  local provider; provider="$(fleet_default_provider)"
  # always apply the supervisor role prompt — including on resume (so doc updates
  # take effect when recycled); --append-system-prompt composes with --resume.
  local primer; primer="$(cat "$TOOL_ROOT/skill/SUPERVISOR.md" 2>/dev/null)"
  primer+=$'\n\n=== Current authoritative decisions (bounded) ===\n'
  primer+="$(_fleet_decisions_current_print "" "${FLEET_SUPERVISOR_DECISIONS_MAX:-12}" 0 2>/dev/null || printf '(decision ledger unavailable)')"
  local sid=""; [[ -f "$RUN_DIR/supervisor.session" ]] && sid="$(<"$RUN_DIR/supervisor.session")"
  local prompt="${FLEET_START_NUDGE:-}"
  if [[ -n "$sid" ]]; then
    # nudge the resumed supervisor to re-survey the fleet (see fleet_tmux_start_child)
    local nudge="${FLEET_RESUME_NUDGE-carry on}"
    [[ -n "$nudge" ]] && prompt="$nudge"
  fi
  local pm="${FLEET_SUPERVISOR_PERMISSION_MODE:-}"
  local -a cargs=()
  fleet_agent_build_args cargs "$provider" supervisor fleet-supervisor "$WORKSPACE" "$primer" "$prompt" "$sid" "$pm"
  local exitfile="$RUN_DIR/supervisor.exit"; rm -f "$exitfile"; mkdir -p "$RUN_DIR"
  fleet_tmux_new_agent_window supervisor "$WORKSPACE" "$exitfile" "$provider" cargs
  fleet_state_ensure supervisor "$WORKSPACE" true
  fleet_state_jq supervisor --arg p "$provider" --arg cwd "$WORKSPACE" \
    '.state="running" | .reason=null | .role="supervisor" | .provider=$p | .cwd=$cwd | .managed=true' >/dev/null
  fleet_log supervisor - "started"
}

fleet_start_supervisor_companion() {
  local base_provider provider id="supervisor-codex"
  fleet_tmux_has_window "$id" && return 0
  base_provider="$(_fleet_id_provider supervisor)"
  provider="${FLEET_SUPERVISOR_COMPANION_PROVIDER:-$(_fleet_opposite_provider "$base_provider")}"
  _fleet_validate_provider "$provider"
  _fleet_provider_available "$provider" || { warn "supervisor: provider '$provider' CLI not found; skipping supervisor companion"; return 0; }
  fleet_ensure_managed_settings
  fleet_tmux_ensure_session
  local primer prompt sid exitfile
  primer="$(cat "$TOOL_ROOT/skill/SUPERVISOR.md" 2>/dev/null)"
  primer+=$'\n\n=== Current authoritative decisions (bounded) ===\n'
  primer+="$(_fleet_decisions_current_print "" "${FLEET_SUPERVISOR_DECISIONS_MAX:-12}" 0 2>/dev/null || printf '(decision ledger unavailable)')"
  prompt="Backup supervisor; stay silent. Speak only on evidenced divergence, missed exhaustion/conflict/handoff fault, direct question, or promotion. On failover, verify ground truth and take over."
  local _sf; sid=""; _sf="$(fleet_run_path "$id" .session)" && [[ -f "$_sf" ]] && sid="$(<"$_sf")"
  [[ -n "$sid" && -n "${FLEET_RESUME_NUDGE-carry on}" ]] && prompt="${FLEET_RESUME_NUDGE-carry on}"
  local -a cargs=()
  # A supervisor companion is a refuter/standby, not a writer. Plan maps to a
  # read-only sandbox with approval=never, so it can investigate unattended.
  fleet_agent_build_args cargs "$provider" "$id" fleet-supervisor-codex "$WORKSPACE" "$primer" "$prompt" "$sid" "plan"
  exitfile="$(fleet_run_path "$id" .exit)" || return 1; rm -f "$exitfile"; mkdir -p "$RUN_DIR"
  fleet_tmux_new_agent_window "$id" "$WORKSPACE" "$exitfile" "$provider" cargs
  fleet_state_ensure "$id" "$WORKSPACE" true
  fleet_state_jq "$id" --arg p "$provider" --arg cwd "$WORKSPACE" \
    '.state="running" | .reason=null | .role="supervisor" | .provider=$p | .cwd=$cwd | .managed=true | .companion_for="supervisor" | .current_task="Backup fleet supervisor lane"' >/dev/null
  fleet_log supervisor "$id" "started provider=$provider companion_for=supervisor"
}

cmd_supervise() {
  local pair=0
  while [[ $# -gt 0 ]]; do case "$1" in
    --pair|--pairs) pair=1; shift ;;
    -h|--help) die "usage: fleet supervise [--pair]" ;;
    *) die "unknown supervise option '$1'" ;;
  esac; done
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_has_tmux || die "tmux required for the supervisor session. Run: sudo apt install tmux"
  if fleet_tmux_has_window supervisor; then
    info "supervisor already running."
  else
    fleet_start_supervisor; info "supervisor session started."
  fi
  if [[ "$pair" == 1 || "${FLEET_SUPERVISOR_PAIR:-off}" == on ]]; then
    fleet_start_supervisor_companion
  fi
  info "attach with:  fleet attach supervisor"
}

cmd_up() {
  local no_sup=0 start_pairs=0
  # Workspace policy lives in .fleet/env. Load it before reading the auto-pair
  # default; the old order silently ignored FLEET_PAIR_ON_UP from that file and
  # honoured it only when inherited from the launching shell.
  fleet_load_paths
  [[ "${FLEET_PAIR_ON_UP:-off}" == on ]] && start_pairs=1
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --no-supervisor) no_sup=1; shift ;;
      --pairs|--with-pairs) start_pairs=1; shift ;;
      --no-pairs|--single|--single-agent) start_pairs=0; shift ;;
      -h|--help) die "usage: fleet up [--no-supervisor] [--pairs] [id]" ;;
      *) break ;;
    esac
  done
  fleet_manifest_load "$MANIFEST"
  # Serialize 'fleet up' per workspace so two starts (e.g. the boot service and
  # a manual run) can't race into duplicate windows/agents. The per-window
  # has-window guard is checked-then-acted, so without this a tight race could
  # double-resume a session.
  mkdir -p "$RUN_DIR"; exec 8>"$RUN_DIR/up.lock"
  if ! flock -n 8; then warn "another 'fleet up' is in progress for this workspace — skipping"; return 0; fi
  fleet_ensure_managed_settings
  local only="${1:-}"
  local id started=0
  for id in "${CHILD_IDS[@]:-}"; do
    [[ -n "$id" ]] || continue
    [[ -n "$only" && "$id" != "$only" ]] && continue
    if _fleet_manifest_marks_companion "$id"; then
      warn "up: '$id' is a manifest companion; start its base or use fleet pair"
      continue
    fi
    faculty_mount "$id"; started=$(( started + 1 ))
    info "up: started '$id'"
    if [[ "$start_pairs" == 1 ]]; then
      _fleet_start_companion "$id" "" "" up
    fi
  done
  (( started == 0 )) && warn "nothing started (check id / manifest)"
  if [[ -z "$only" && "$no_sup" == 0 ]]; then
    fleet_start_supervisor && info "up: started 'supervisor'"
    if [[ "$start_pairs" == 1 && "${FLEET_SUPERVISOR_PAIR:-on}" != off ]]; then
      fleet_start_supervisor_companion
    fi
  fi
  # Optional decision-ledger pane. Current state is already in fleet brief and
  # every worker primer, so a permanent pane is off by default.
  # and made strictly non-fatal: wrapped so a failure here can never break startup.
  if [[ "${FLEET_DECISIONS_WINDOW:-off}" == on ]]; then
    if ( fleet_start_decisions_window ) 2>/dev/null; then
      fleet_tmux_has_window decisions 2>/dev/null && info "up: started 'decisions' window"
    else
      warn "up: 'decisions' window not started (non-fatal) — 'fleet decisions' still works"
    fi
  fi
  fleet_reorder_windows
  info "tmux session '$FLEET_TMUX_SESSION' — attach with: fleet attach <id>"
}

cmd_down() {
  fleet_load_paths
  local only="${1:-}"
  _fleet_guard_primary_lifecycle down "$only"
  if [[ -n "$only" ]]; then
    faculty_unmount "$only"
    fleet_state_jq "$only" '.state="stopped" | .reason="fleet down"' >/dev/null || true
    fleet_log down "$only" "intentional"
    info "down: stopped '$only'"
    return
  fi
  [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  local id
  for id in $(fleet_state_ids); do
    fleet_tmux_has_window "$id" 2>/dev/null || continue
    faculty_unmount "$id"
    fleet_state_jq "$id" '.state="stopped" | .reason="fleet down"' >/dev/null || true
    info "down: stopped '$id'"
  done
  if fleet_tmux_session_exists; then fleet_tmux kill-session -t "$FLEET_TMUX_SESSION" 2>/dev/null || true; fi
  # killing the session ends the tmux server, so its transient user unit goes
  # inactive on its own; just clear any leftover failed state.
  if fleet_tmux_user_manager_ok; then systemctl --user reset-failed "$FLEET_TMUX_UNIT" 2>/dev/null || true; fi
  fleet_log down "-" "suite"
}

# Install a per-user systemd unit so the fleet auto-starts on boot and resumes
# every agent. Renders templates/fleet.service.example for the current workspace.
# --- git hooks: install the managed repos' publish guard -----------------------
# Distinct from `install-hooks`, which installs the SELF-REPORTING hooks into
# .claude/settings.json. This one installs the repo-level GIT hook (the pre-push
# secret/MAC + decision-accountability guard) into <repo>/.git/hooks/. Until now nothing installed it at all, which is
# exactly why deployed drifted from source for weeks — see lib/githooks.sh.
#
# Idempotent + safe to re-run. A pre-existing FOREIGN hook is preserved as pre-push.local
# (our hook chains to it), never clobbered.
cmd_install_git_hooks() {
  local dry=0
  while [[ $# -gt 0 ]]; do case "$1" in --dry-run|-n) dry=1; shift ;; *) break ;; esac; done
  local hook src
  while read -r hook; do
    src="$(fleet_git_hook_src "$hook")"
    [[ -f "$src" ]] || die "no hook at $src (is this a full checkout?)"
  done < <(fleet_git_hook_names)

  # ⚠ SEQUENCING TRAP, made visible rather than documented-and-forgotten: this installs from
  # the RUNNING checkout, on whatever branch it is on — not origin/master. Print it every run.
  printf '%sfleet install-git-hooks%s%s\n' "$c_bold" "$c_reset" "$([[ $dry == 1 ]] && printf ' (dry-run)')"
  printf '  source: %s/hooks/git/\n  branch: %s\n' "$TOOL_ROOT" "$(fleet_git_hook_provenance)"

  local -a repos=()
  if [[ $# -gt 0 ]]; then
    repos=("$@")
  else
    fleet_load_paths
    [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
    local id rcwd; local -A seen_repo=()
    for id in "${CHILD_IDS[@]:-}"; do
      [[ -n "$id" ]] || continue
      rcwd="$(fleet_child_get "$id" cwd "")"; [[ -n "$rcwd" ]] || continue
      [[ "$rcwd" != /* ]] && rcwd="$WORKSPACE/$rcwd"
      rcwd="$(cd "$rcwd" 2>/dev/null && pwd -P)" || continue
      [[ -n "${seen_repo[$rcwd]:-}" ]] && continue
      seen_repo["$rcwd"]=1; repos+=("$rcwd")
    done
    # The tool's own repo is doctor-checked for drift but has no manifest child, so
    # without this it is the one repo the fixer can never reach.
    rcwd="$(cd "$TOOL_ROOT" 2>/dev/null && pwd -P)" || rcwd=""
    if [[ -n "$rcwd" && -z "${seen_repo[$rcwd]:-}" && -d "$rcwd/.git" ]]; then
      seen_repo["$rcwd"]=1; repos+=("$rcwd")
    fi
  fi
  [[ ${#repos[@]} -gt 0 ]] || { printf '  (no managed repos found)\n'; return 0; }

  local r act
  for r in "${repos[@]}"; do
    while read -r hook; do
      act="$(fleet_install_git_hook "$r" "$([[ $dry == 1 ]] && printf dry)" "$hook")" || act=notgit
      case "$act" in
        notgit)    printf '  %s—%s    %s (%s: not a git repo — skipped)\n' "$c_dim" "$c_reset" "$r" "$hook" ;;
        current)   printf '  %sok%s   %s (%s already current)\n' "$c_grn" "$c_reset" "$r" "$hook" ;;
        updated)   printf '  %sok%s   %s (%s updated)\n' "$c_grn" "$c_reset" "$r" "$hook" ;;
        installed) printf '  %sok%s   %s (%s installed)\n' "$c_grn" "$c_reset" "$r" "$hook" ;;
        preserved) printf '  %sok%s   %s (%s installed; existing hook preserved as %s.local and chained)\n' \
                     "$c_grn" "$c_reset" "$r" "$hook" "$hook" ;;
      esac
    done < <(fleet_git_hook_names)
  done
}

cmd_install_service() {
  fleet_load_paths
  command -v systemctl >/dev/null 2>&1 || die "systemctl not found — boot auto-start needs systemd user services."
  local tmpl="$TOOL_ROOT/templates/fleet.service.example"
  [[ -f "$tmpl" ]] || die "missing template: $tmpl"
  local bin="$TOOL_ROOT/bin/fleet"
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  local unit="$dir/$FLEET_SERVICE_NAME"
  mkdir -p "$dir"
  sed -e "s|__WORKSPACE__|$WORKSPACE|g" -e "s|__FLEET_BIN__|$bin|g" "$tmpl" > "$unit"
  systemctl --user daemon-reload 2>/dev/null || true
  systemctl --user enable "$FLEET_SERVICE_NAME" >/dev/null 2>&1 || warn "could not enable $FLEET_SERVICE_NAME"
  info "installed user service: $unit"
  info "  workspace: $WORKSPACE"
  if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]]; then
    warn "lingering is OFF — the service won't start until you log in, and the fleet"
    warn "won't survive logout. Enable it once with:  loginctl enable-linger $USER"
  fi
  info "start now:     systemctl --user start $FLEET_SERVICE_NAME"
  info "stop:          systemctl --user stop $FLEET_SERVICE_NAME    (runs 'fleet down')"
  info "disable boot:  systemctl --user disable $FLEET_SERVICE_NAME"
}

cmd_restart() {
  local id="${1:?usage: fleet restart <id>}"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  _fleet_guard_primary_lifecycle restart "$id"
  fleet_restart_child "$id" force
  info "restart: '$id'"
}

_fleet_validate_provider() {
  case "$1" in
    claude|codex) return 0 ;;
    *) die "unknown provider '$1' (expected claude or codex)" ;;
  esac
}

_fleet_opposite_provider() {
  case "$1" in
    claude) printf 'codex\n' ;;
    codex)  printf 'claude\n' ;;
    *)      printf '%s\n' "$(fleet_default_provider)" ;;
  esac
}

_fleet_id_provider() {
  local id="$1" p
  p="$(fleet_state_get "$id" '.provider' "")"
  if [[ -z "$p" || "$p" == "null" ]]; then
    if [[ "$id" == "supervisor" ]]; then p="$(fleet_default_provider)"
    elif [[ "$id" == supervisor-* ]]; then p="${id#supervisor-}"
    else p="$(fleet_provider_for_child "$id")"; fi
  fi
  case "$p" in claude|codex) printf '%s\n' "$p" ;; *) fleet_default_provider ;; esac
}

_fleet_id_cwd() {
  local id="$1" cwd rel
  fleet_is_supervisor_id "$id" && { printf '%s\n' "$WORKSPACE"; return; }
  cwd="$(fleet_state_get "$id" '.cwd' "")"
  if [[ -n "$cwd" && "$cwd" != "null" ]]; then printf '%s\n' "$cwd"; return; fi
  rel="$(fleet_child_get "$id" cwd "")"
  [[ -n "$rel" ]] || die "unknown member '$id' (no state doc and not in the manifest)"
  cwd="$WORKSPACE/$rel"; [[ "$rel" == /* ]] && cwd="$rel"
  printf '%s\n' "$cwd"
}

_fleet_live_companion_id() {
  local base="$1" provider="$2" expected id p c
  expected="$base-$provider"
  if fleet_tmux_has_window "$expected" 2>/dev/null; then
    printf '%s\n' "$expected"
    return 0
  fi
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    fleet_tmux_has_window "$id" 2>/dev/null || continue
    p="$(_fleet_id_provider "$id")"
    [[ "$p" == "$provider" ]] || continue
    c="$(fleet_state_get "$id" '.companion_for' "")"
    [[ "$c" == "$base" ]] || continue
    printf '%s\n' "$id"
    return 0
  done < <(fleet_state_ids)
  return 1
}

_fleet_is_readonly_standby() {
  local id="$1" role mode writer
  role="$(fleet_state_get "$id" '.role' "")"
  mode="$(fleet_state_get "$id" '.pair_mode' "")"
  writer="$(fleet_state_get "$id" '.writer' "")"
  [[ "$role" == "standby" || "$mode" == "read_only" || "$writer" == "false" ]]
}

# --- AUTHORITY GUARD: a read-only companion / refuter lane must NOT run
# lifecycle commands (handoff/failover/down/restart) against its own primary or
# logical pair. Only human root (no FLEET_CHILD_ID in env) or the authorized
# primary/writer may. INCIDENT 2026-07-16: supervisor-codex ran
# `handoff --stop-source supervisor` and stopped the PRIMARY supervisor. The
# handoff was warranted, but the *mechanism* — a companion killing its primary —
# must be human-gated, not a peer power. Denies + audits; every other
# invocation is unchanged. A companion is identified by .companion_for being set
# (e.g. supervisor-codex has role=supervisor, so the readonly-standby check is
# Strip a companion suffix to recover the primary's id. LAST RESORT ONLY — the
# recorded fact (.companion_for, then .refutes) is preferred, because a name is a
# label and a label has to be parsed by a rule that can fall behind the rule that
# generates it. IT DID: `fleet refute` mints `$target-$provider-refute`, so a
# claude companion is `r2-claude-refute`, and this stripper knew `-codex-refute`,
# `-refute` and `-codex` and NOTHING ABOUT `-claude`. It recovered `r2-claude` —
# a lane that has never existed — and the refuter was refused when messaging
# either real reader, having been told it may only address a name nothing answers
# to. Two halves of one convention, and only the generator was ever updated.
_fleet_companion_base() {
  local b="${1%-refute}"
  case "$b" in
    *-codex)  b="${b%-codex}" ;;
    *-claude) b="${b%-claude}" ;;
  esac
  printf '%s\n' "$b"
}

# NOT sufficient), OR readonly-standby state, OR a *-refute name.
_fleet_actor_is_readonly_companion() {
  local a="$1"
  [[ -n "$a" ]] || return 1
  [[ -n "$(fleet_state_get "$a" '.companion_for' "")" ]] && return 0
  _fleet_is_readonly_standby "$a" 2>/dev/null && return 0
  # NAME-STRUCTURAL fallback — MUST NOT depend on state being readable.
  # `_fleet_start_companion` names every companion "<base>-<provider>", so a
  # *-codex / *-refute lane IS a companion BY CONSTRUCTION, whatever its state
  # file says (or fails to say).
  #
  # INCIDENT 2026-07-17 (this pattern is the fix): supervisor-codex's state file
  # was ZERO BYTES, so the `.companion_for` read and the readonly-standby read
  # both came back empty, and the old pattern matched only *-refute — so "-codex"
  # fell through, the guard concluded "not a companion", and ALLOWED it to
  # BROADCAST real identity values (a provisioned frame embedding the live
  # tg_hash/origin) fleet-wide, asking lanes to commit them as canonical vectors.
  # The sibling -codex lanes were denied correctly ONLY because their state files
  # happened to be intact — i.e. the guard's coverage silently depended on an
  # unrelated file staying non-empty. A guard that FAILS OPEN on unreadable state
  # is not a guard; identity here is derived from the NAME, which cannot be
  # corrupted by a truncated write.
  case "$a" in *-codex|*-refute) return 0 ;; esac   # *-codex-refute already ends in -refute
  return 1
}
_fleet_guard_primary_lifecycle() {
  local cmd="$1" target="${2:-}" actor="${FLEET_CHILD_ID:-}"
  [[ -z "$actor" ]] && return 0                            # human root — always allowed
  _fleet_actor_is_readonly_companion "$actor" || return 0  # actor is a primary/writer — allowed
  local primary base
  primary="$(fleet_state_get "$actor" '.companion_for' "")"
  [[ -n "$primary" ]] || primary="$(fleet_state_get "$actor" '.refutes' "")"
  base="$(_fleet_companion_base "$actor")"
  # deny when the target is the actor's primary/logical pair, or the whole suite
  # (empty target = down/failover all, which includes the primary).
  if [[ -z "$target" || "$target" == "$primary" || "$target" == "$base" ]]; then
    fleet_log security "$actor" "DENIED $cmd target='${target:-<suite>}' — read-only companion/refuter may not run lifecycle on its primary/pair (primary='${primary:-$base}')"
    die "refused: '$actor' is a read-only companion/refuter and may not '$cmd' its primary/logical pair ('${target:-<whole suite>}'). Only human root or the authorized primary can do this. (audit logged)"
  fi
  return 0
}

# --- MESSAGING AUTHORITY GUARD: a read-only companion / refuter lane exists to
# FEED OBSERVATIONS to its primary, which then decides and relays. It must not
# itself issue fleet-wide coordination. INCIDENT 2026-07-16: supervisor-codex
# repeatedly BROADCAST HOLD/RESUME/deconflict coordination that countermanded
# the primary supervisor, freezing core/hive/android; the lifecycle guard above
# closed the kill path, this closes the *messaging* path (same root: a companion
# must not exercise primary authority). Structural rule:
#   • broadcast / pair-send  → DENIED for a companion (that IS fleet-wide coord)
#   • send                   → a companion may message ONLY its own primary/pair
#                              (the legitimate feed-up channel)
#   • ask                    → still allowed (read-only off-thread inquiry, no
#                              directive lands in a thread)
# Human root (no FLEET_CHILD_ID) and normal writers are unaffected. Denies+audits.
_fleet_guard_messaging() {
  local kind="$1" from="$2" to="${3:-}"      # to empty for broadcast/pair
  [[ -z "$from" || "$from" == "supervisor" ]] && return 0   # human / primary supervisor
  _fleet_actor_is_readonly_companion "$from" 2>/dev/null || return 0  # writer/primary — allowed
  local primary base
  primary="$(fleet_state_get "$from" '.companion_for' "")"
  [[ -n "$primary" ]] || primary="$(fleet_state_get "$from" '.refutes' "")"
  base="$(_fleet_companion_base "$from")"
  primary="${primary:-$base}"
  case "$kind" in
    broadcast|pair)
      fleet_log security "$from" "DENIED $kind — read-only companion/refuter may not issue fleet-wide coordination (feed primary '$primary' instead)"
      die "refused: '$from' is a read-only companion/refuter and may not '$kind' (fleet-wide coordination). Send your observation to your primary ('$primary'); the primary decides + relays. (audit logged)"
      ;;
    msg)
      # ‼ THE ADJUDICATOR IS NOT A PEER, AND ROUTING A VERDICT THROUGH THE LANE IT JUDGES IS
      #   NOT INDEPENDENCE. Until 2026-09-01 a refuter could message ONLY its primary, so a
      #   falsifier's verdicts about r2 reached the supervisor THROUGH r2 — the one party with
      #   a reason to soften, delay or drop them. No malice is required; a busy lane
      #   summarising is enough. MEASURED: r2-codex-refute was told to report to the
      #   supervisor, hit this refusal, and proposed relaying through r2 instead — it reported
      #   the constraint rather than quietly complying, which is how this was found.
      #
      # ‼ THE EXCEPTION IS NARROW ON PURPOSE. A supervisor lane is the ADJUDICATOR of this
      #   companion's findings and cannot be reached any other way. `broadcast` and `pair`
      #   stay denied — those ARE fleet-wide coordination — and a message to any OTHER peer
      #   stays denied, so this does not become a side channel between companions.
      #   ‼ AND `supervisor-*` MATCHES A SUPERVISOR'S OWN REFUTER, WHICH IS A COMPANION.
      #     Allowing that would be a companion-to-companion side channel wearing the
      #     adjudicator's name — the exact thing this guard exists to prevent — so the
      #     target must be a supervisor lane AND NOT itself read-only.
      local _to_ok=0
      if fleet_is_supervisor_id "$to" 2>/dev/null && ! _fleet_actor_is_readonly_companion "$to" 2>/dev/null; then _to_ok=1; fi
      if [[ "$to" != "$primary" && "$to" != "$base" && $_to_ok -eq 0 ]]; then
        fleet_log security "$from" "DENIED send to='$to' — read-only companion/refuter may message only its primary ('$primary') or a supervisor lane"
        die "refused: '$from' is a read-only companion/refuter and may only message its primary ('$primary') or a supervisor lane, not '$to'. Route coordination through the primary. (audit logged)"
      fi
      ;;
  esac
  return 0
}

# Provenance prefix (partial #78): mark messages that ORIGINATE from a read-only
# companion so a recipient can tell a companion's advisory from the primary's
# authoritative signal, even on the one path a companion may still use (→ its
# primary). Empty for the supervisor/writers (no change to their messages).
# NOTE: this is the textual floor; cryptographic supervisor-signal provenance
# (#78) remains a separate queued design.
_fleet_authority_tag() {
  local from="$1"
  [[ -z "$from" || "$from" == "supervisor" ]] && return 0
  _fleet_actor_is_readonly_companion "$from" 2>/dev/null && printf '[companion·advisory — not authoritative] '
  return 0
}

_fleet_takeover_permission_mode() {
  local provider="$1" source_id="${2:-}" pm=""
  pm="$(fleet_child_get "$source_id" permission_mode "" 2>/dev/null || true)"
  case "$provider" in
    codex|claude) printf 'bypassPermissions\n' ;;
    *) printf '%s\n' "$pm" ;;
  esac
}

_fleet_limited_lines() {
  local max="$1"
  sed -n "1,${max}p"
}

_fleet_member_claims() {
  local id="$1"
  fleet_state_get "$id" '.claims[]?' "" 2>/dev/null | _fleet_limited_lines "${FLEET_HANDOFF_MAX_CLAIMS:-20}" || true
}

fleet_resume_filename() { printf '%s\n' "${FLEET_RESUME_FILE:-RESUME.md}"; }

_fleet_resume_path() {
  local cwd="$1"
  printf '%s/%s\n' "$cwd" "$(fleet_resume_filename)"
}

_fleet_resume_excerpt() {
  local cwd="$1" max="${2:-${FLEET_RESUME_LINES:-60}}" bytes="${FLEET_RESUME_EXCERPT_BYTES:-6000}" f
  f="$(_fleet_resume_path "$cwd")"
  [[ -f "$f" ]] || return 0
  [[ "$max" =~ ^[0-9]+$ ]] || max=60
  [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=6000
  (( max <= 0 )) && return 0
  (( bytes > 0 )) || return 0
  sed -n "1,${max}p" "$f" 2>/dev/null | head -c "$bytes" || true
}

_fleet_resume_template() {
  local id="$1" cwd="$2" task="$3"
  cat <<EOF
# Resume: $id

Last updated: TODO (UTC)

## Current Objective
${task:-TODO}

## Authoritative Current State
- Decision latch IDs governing this work: TODO (or "none").
- One current interpretation only; move superseded narrative out of this file.

## Last Verified State
- TODO: what was checked against ground truth, with command/output summary.

## Next Actions
- TODO: the next concrete step another agent should take.

## Changed Files / Claims
- TODO: files touched or intentionally left dirty.

## Verification
- TODO: tests/builds/checks run, exact commands, and result.

## GitHub Sync
- TODO: branch, upstream, pushed commit, and ahead=0 check (or exact push blocker).

## Blockers / Risks
- TODO: decisions needed, known risks, flaky checks, unresolved questions.

## Handoff Notes
- Repo: $cwd
- Branch/commit: TODO
- Anything the next agent must not assume: TODO
EOF
}

_fleet_resume_contract() {
  local fn; fn="$(fleet_resume_filename)"
  cat <<EOF
Keep repo-local $fn as one concise current snapshot: objective; verified facts;
next action; task-owned changes; checks; blockers; decision IDs; branch/upstream/
push. Update after meaningful work and before idle. No diary or competing current
sections. Ledger wins conflicts. Never hide unpushed commits.
EOF
}

_fleet_git_sync_problem() {
  local id="$1" cwd="$2" origin upstream ahead branch
  [[ "${FLEET_GITHUB_SYNC_CHECK:-on}" == off ]] && return 0
  git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  origin="$(git -C "$cwd" remote get-url origin 2>/dev/null || true)"
  if [[ -z "$origin" ]]; then
    printf '%s: git repo has no origin remote; verified work has no GitHub recovery target\n' "$id"
    return 0
  fi
  # This requirement is specifically for GitHub-backed repos. Leave other remote
  # schemes to workspace policy rather than mislabelling them GitHub.
  [[ "$origin" == *github.com* ]] || return 0
  branch="$(git -C "$cwd" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ -z "$branch" ]]; then
    printf '%s: git HEAD is detached; cannot keep a branch synchronized with GitHub\n' "$id"
    return 0
  fi
  upstream="$(git -C "$cwd" rev-parse --abbrev-ref '@{u}' 2>/dev/null || true)"
  if [[ -z "$upstream" ]]; then
    printf '%s: branch %s has no upstream; push with -u so GitHub synchronization is checkable\n' "$id" "$branch"
    return 0
  fi
  ahead="$(git -C "$cwd" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
  [[ "$ahead" =~ ^[0-9]+$ ]] || ahead=0
  if (( ahead > 0 )); then
    printf '%s: branch %s is %s commit(s) ahead of %s; non-force-push verified increments before idle/done\n' \
      "$id" "$branch" "$ahead" "$upstream"
  fi
}

_fleet_resume_status_problem() {
  local id="$1" cwd="$2" role state f mt act delta stale bytes max_bytes
  [[ "${FLEET_RESUME_CHECK:-on}" == "off" ]] && return 0
  fleet_is_supervisor_id "$id" && return 0
  role="$(fleet_state_get "$id" '.role' "")"
  [[ "$role" == "adversary" ]] && return 0
  [[ -d "$cwd" ]] || return 0
  f="$(_fleet_resume_path "$cwd")"
  if [[ ! -f "$f" ]]; then
    printf '%s: missing %s repo-local handoff file\n' "$id" "$(fleet_resume_filename)"
    return 0
  fi
  if [[ ! -s "$f" ]]; then
    printf '%s: %s is empty\n' "$id" "$(fleet_resume_filename)"
    return 0
  fi
  max_bytes="${FLEET_RESUME_MAX_BYTES:-65536}"
  [[ "$max_bytes" =~ ^[0-9]+$ ]] || max_bytes=65536
  bytes="$(wc -c < "$f" 2>/dev/null || echo 0)"; bytes="${bytes//[[:space:]]/}"
  [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=0
  if (( max_bytes > 0 && bytes > max_bytes )); then
    printf '%s: %s is %s bytes (> %s); compact it to one authoritative current state and archive history elsewhere\n' \
      "$id" "$(fleet_resume_filename)" "$bytes" "$max_bytes"
    return 0
  fi
  if [[ "${FLEET_RESUME_TODO_CHECK:-on}" != "off" ]] && grep -qE '(^|[^[:alnum:]_])TODO([^[:alnum:]_]|$)' "$f" 2>/dev/null; then
    printf '%s: %s still contains TODO placeholders\n' "$id" "$(fleet_resume_filename)"
    return 0
  fi
  # Intentional shutdown is not work. Starting a seed-only session updates its
  # transcript/heartbeat even when it makes no change; after `fleet down`, using
  # that timestamp as handoff debt makes a clean start/stop permanently red.
  # Presence, size, and placeholder checks above still apply to stopped members.
  state="$(fleet_state_get "$id" '.state' "")"
  [[ "$state" == "stopped" ]] && return 0
  stale="${FLEET_RESUME_STALE_SECS:-3600}"
  [[ "$stale" =~ ^[0-9]+$ ]] || stale=3600
  (( stale <= 0 )) && stale=0
  mt="$(fleet_mtime "$f")"
  act="$(fleet_last_activity "$id")"
  if (( act > 0 && mt > 0 )); then
    delta=$(( act - mt ))
    if (( delta > stale )); then
      printf '%s: %s stale by %ss relative to last activity\n' "$id" "$(fleet_resume_filename)" "$delta"
    fi
  fi
}

_fleet_repo_onboarding_problem() {
  local id="$1" cwd="$2"
  [[ "${FLEET_REPO_ONBOARDING_CHECK:-on}" == off ]] && return 0
  [[ -d "$cwd" ]] || return 0
  if [[ ! -f "$cwd/AGENTS.md" ]]; then
    printf '%s: missing AGENTS.md; run fleet init-repo %s\n' "$id" "$id"
    return 0
  fi
  if [[ ! -f "$cwd/DECISIONS.md" ]]; then
    printf '%s: missing DECISIONS.md; run fleet init-repo %s\n' "$id" "$id"
    return 0
  fi
  if grep -qF 'TODO(fleet-onboarding)' "$cwd/AGENTS.md" 2>/dev/null; then
    printf '%s: AGENTS.md has unresolved fleet onboarding fields; hold cross-repo and behavioural work\n' "$id"
  fi
}

_fleet_transcript_excerpt() {
  local id="$1" max="${2:-24}" cwd sid provider tf out bytes="${FLEET_TRANSCRIPT_EXCERPT_BYTES:-6000}"
  cwd="$(fleet_state_get "$id" '.cwd' "")"
  sid="$(fleet_state_get "$id" '.session_id' "")"
  provider="$(_fleet_id_provider "$id")"
  [[ -n "$cwd" && -n "$sid" && "$sid" != "null" ]] || return 0
  tf="$(fleet_transcript_path "$cwd" "$sid" "$provider")"
  [[ -f "$tf" ]] || return 0
  out="$(tail -n "${FLEET_HANDOFF_TRANSCRIPT_LINES:-800}" "$tf" 2>/dev/null \
    | jq -r '
        def flatten:
          if type=="string" then .
          elif type=="array" then map(if type=="object" then (.text // .content // "") elif type=="string" then . else "" end) | join(" ")
          elif type=="object" then (.text // .content // .message // .prompt // .input // "")
          else "" end;
        (.role // .type // "") as $r
        | (.message.content // .content // .text // .prompt // .input // empty) as $c
        | ($c|flatten) as $t
        | select($t != "")
        | (($r|ascii_upcase) + ": " + $t)' 2>/dev/null \
    | sed 's/[[:space:]][[:space:]]*/ /g; s/^[[:space:]]*//; s/[[:space:]]*$//' \
    | awk 'NF' \
    | tail -n "$max" || true)"
  [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=6000
  if (( bytes > 0 )); then
    head -c "$bytes" <<<"$out" || true
  fi
}

_fleet_git_context() {
  local cwd="$1" ref="${2:-}" branch status stat names
  if ! git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf '(not a git working tree)\n'
    return 0
  fi
  branch="$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  status="$(git -C "$cwd" status --short 2>/dev/null | head -n "${FLEET_HANDOFF_GIT_LINES:-40}" || true)"
  if [[ -n "$ref" ]]; then
    stat="$(git -C "$cwd" diff --stat "$ref" -- 2>/dev/null | head -n "${FLEET_HANDOFF_GIT_LINES:-40}" || true)"
    names="$(git -C "$cwd" diff --name-only "$ref" -- 2>/dev/null | head -n "${FLEET_HANDOFF_GIT_LINES:-40}" || true)"
  else
    stat="$(git -C "$cwd" diff --stat 2>/dev/null | head -n "${FLEET_HANDOFF_GIT_LINES:-40}" || true)"
    names="$(git -C "$cwd" diff --name-only 2>/dev/null | head -n "${FLEET_HANDOFF_GIT_LINES:-40}" || true)"
  fi
  printf 'branch: %s\n' "${branch:-unknown}"
  printf 'status --short:\n%s\n' "${status:-  (clean or unavailable)}"
  printf 'diff --stat%s:\n%s\n' "${ref:+ $ref}" "${stat:-  (no diff stat)}"
  printf 'diff --name-only%s:\n%s\n' "${ref:+ $ref}" "${names:-  (no changed files)}"
}

_fleet_handoff_prompt() {
  local from="$1" to="$2" source_provider="$3" target_provider="$4" task_override="$5"
  local cwd task claims excerpt gitctx resume resume_path decision_ctx
  cwd="$(_fleet_id_cwd "$from")"
  task="$(fleet_state_get "$from" '.current_task' "")"
  [[ -n "$task_override" ]] && task="$task_override"
  claims="$(_fleet_member_claims "$from")"
  resume="$(_fleet_resume_excerpt "$cwd")"
  resume_path="$(_fleet_resume_path "$cwd")"
  decision_ctx="$(_fleet_decisions_current_print "$from" "${FLEET_HANDOFF_DECISIONS_MAX:-12}" 0 2>/dev/null || true)"
  excerpt="$(_fleet_transcript_excerpt "$from" "${FLEET_HANDOFF_EXCERPT_LINES:-28}")"
  gitctx="$(_fleet_git_context "$cwd")"
  cat <<EOF
You are "$to", a $target_provider fleet member taking over work from "$from" ($source_provider).

This is a CROSS-PROVIDER HANDOFF. You cannot resume the source provider's private
conversation state directly. Treat this packet as orientation, then verify
against ground truth in the working tree before acting.

Takeover rules:
- You are sole writer now. Verify git/files/tests; packet is orientation, not truth.
- Preserve valid progress. Continue task only if ground truth and latches support it.
- Ledger beats RESUME/transcript. Challenge does not reverse RATIFIED action;
  authority revocation/successor required. Never impersonate authority.
- Newer explicit human instruction and safety gates still apply.
- done is an action, not proof of tests/review/commit/push.
- Ambiguous? Send supervisor one smallest evidence-backed question.

Source member: $from
Source provider: $source_provider
Target provider: $target_provider
Working directory: $cwd
Current task:
${task:-  (none recorded)}

Current authoritative decisions (bounded):
${decision_ctx:-  (no active latches or open gates)}

Repo-local takeover state ($resume_path):
${resume:-  (missing or empty; treat this as a handoff-quality problem and reconstruct from git/fleet state)}

Files the source member claimed recently:
${claims:-  (none recorded)}

Git context at handoff:
$gitctx

Recent transcript excerpt:
${excerpt:-  (no transcript excerpt available)}
EOF
}

_fleet_refute_prompt() {
  local target="$1" reviewer="$2" target_provider="$3" reviewer_provider="$4" lens="$5" claim="$6" diff_ref="$7"
  local cwd task claims excerpt gitctx claim_text
  cwd="$(_fleet_id_cwd "$target")"
  task="$(fleet_state_get "$target" '.current_task' "")"
  if [[ -n "$claim" ]]; then claim_text="$claim"
  elif [[ -n "$task" ]]; then claim_text="$task"
  else claim_text="  (no claim supplied; review the target member's current work and claimed files)"
  fi
  claims="$(_fleet_member_claims "$target")"
  excerpt="$(_fleet_transcript_excerpt "$target" "${FLEET_REFUTE_EXCERPT_LINES:-20}")"
  gitctx="$(_fleet_git_context "$cwd" "$diff_ref")"
  cat <<EOF
Role: "$reviewer", independent read-only refuter.
Target: $target ($target_provider). You: $reviewer_provider. Repo: $cwd.
Lens: ${lens:-correctness, security, edge cases, regressions, and missing tests}

Never edit, commit, flash, or take over. Verify live code/git. Seek concrete
counterexamples, not approval or speculative lists. Each finding: severity; path;
reproduction/failure; smallest fix. If none survives, name checks run and strongest
untested attack.

Claim or task to attack:
$claim_text

Files the target member claimed recently:
${claims:-  (none recorded)}

Git context:
$gitctx

Recent target transcript excerpt:
${excerpt:-  (no transcript excerpt available)}
EOF
}

_fleet_companion_prompt() {
  local base="$1" companion="$2" base_provider="$3" companion_provider="$4"
  local cwd task claims resume resume_path gitctx
  cwd="$(_fleet_id_cwd "$base")"
  task="$(fleet_state_get "$base" '.current_task' "")"
  claims="$(FLEET_HANDOFF_MAX_CLAIMS="${FLEET_PAIR_MAX_CLAIMS:-5}" _fleet_member_claims "$base")"
  resume="$(_fleet_resume_excerpt "$cwd" "${FLEET_PAIR_RESUME_LINES:-8}")"
  resume_path="$(_fleet_resume_path "$cwd")"
  gitctx="$(FLEET_HANDOFF_GIT_LINES="${FLEET_PAIR_GIT_LINES:-8}" _fleet_git_context "$cwd")"
  cat <<EOF
Role: "$companion", $companion_provider read-only refuter/standby for "$base"
($base_provider writer). Repo: $cwd.

Never edit, commit, reformat, or take over until explicit handoff. Check git,
$resume_path, changed code, tests, security and edge cases. Send only evidenced
findings: severity, path, failure, smallest patch/test. Stay takeover-ready; do not
self-promote. Commands: fleet ask $base "question"; fleet send $base "finding".
After promotion, re-check git and RESUME before writing.

Base member: $base
Base provider: $base_provider
Companion provider: $companion_provider
Current recorded task:
${task:-  (none recorded)}

Repo-local takeover state ($resume_path):
${resume:-  (missing or empty; create/update it before considering this repo handoff-ready)}

Files the base member claimed recently:
${claims:-  (none recorded)}

Git context:
$gitctx
EOF
}

_fleet_provider_available() {
  local provider="$1" bin
  bin="$(fleet_provider_bin "$provider")"
  if [[ "$bin" == */* ]]; then [[ -x "$bin" ]]
  else command -v -- "$bin" >/dev/null 2>&1; fi
}

_fleet_manifest_marks_companion() {
  local id="$1" role companion_for
  role="$(fleet_child_get "$id" role "")"
  companion_for="$(fleet_child_get "$id" companion_for "")"
  [[ "$role" == "companion" || -n "$companion_for" ]]
}

_fleet_start_companion() {
  local base="$1" provider="${2:-}" companion_id="${3:-}" source="${4:-pair}"
  [[ -n "$base" ]] || return 0
  if _fleet_manifest_marks_companion "$base"; then
    [[ "$source" == "up" ]] || warn "$base: manifest marks this as a companion; skipping"
    return 0
  fi

  local base_provider target_provider cid cwd pm primer prompt exitfile summary sid had_skip=0 old_skip=""
  local had_capprove=0 old_capprove="" had_csandbox=0 old_csandbox=""
  base_provider="$(_fleet_id_provider "$base")"
  target_provider="${provider:-$(_fleet_opposite_provider "$base_provider")}"
  _fleet_validate_provider "$target_provider"
  if [[ "$target_provider" == "$base_provider" && "${FLEET_PAIR_ALLOW_SAME_PROVIDER:-off}" != "on" ]]; then
    [[ "$source" == "up" ]] || warn "$base: provider already '$base_provider'; skipping same-provider companion"
    return 0
  fi
  if ! _fleet_provider_available "$target_provider"; then
    warn "$base: provider '$target_provider' CLI not found; skipping companion"
    return 0
  fi

  cid="${companion_id:-$base-$target_provider}"
  fleet_require_member_id "$cid"
  [[ "$cid" != "$base" ]] || { warn "$base: companion id equals base id; skipping"; return 0; }
  # Presence of a window is not reachability of an agent. Under remain-on-exit
  # (FLEET_TMUX_REMAIN_ON_EXIT=on, the "supervisor goes blind" fix) a dead companion
  # leaves a corpse window, and a bare has_window check then reports it "already
  # running" forever — while `fleet up` refuses companion ids and `fleet reap` ignores
  # non-manifest children, so the lane is unrevivable without a manual `fleet down`.
  # Measured 2026-08-01: core-codex sat dead ~4h reporting "already running" while its
  # own state read `stopped`, and seven queued messages never reached it.
  # This is the SAME defect and the SAME remedy as the recycle path in
  # fleet_tmux_start_child (lib/tmux.sh) — probe the pane and RECYCLE a dead one. That
  # fix landed 2026-07-19 for manifest children and THIS CALL SITE WAS MISSED, which is
  # why it bit the same population (codex companions) a second time.
  if fleet_tmux_has_window "$cid"; then
    if fleet_tmux_window_alive "$cid"; then
      info "pair: '$cid' already running for '$base'"
      return 0
    fi
    warn "pair: '$cid' stale window (agent dead) — recycling"
    fleet_tmux kill-window -t "$FLEET_TMUX_SESSION:$cid" 2>/dev/null || true
  fi
  cwd="$(_fleet_id_cwd "$base")"
  [[ -d "$cwd" ]] || { warn "$base: cwd does not exist: $cwd"; return 0; }
  pm="${FLEET_PAIR_PERMISSION_MODE:-plan}"
  primer="$(fleet_peer_primer "$cid")"
  prompt="$(_fleet_companion_prompt "$base" "$cid" "$base_provider" "$target_provider")"
  local _sf; sid=""; _sf="$(fleet_run_path "$cid" .session)" && [[ -f "$_sf" ]] && sid="$(<"$_sf")"
  exitfile="$(fleet_run_path "$cid" .exit)" || return 1; rm -f "$exitfile"; mkdir -p "$RUN_DIR"
  local -a cargs=()
  [[ -n "${FLEET_SKIP_PERMISSIONS+x}" ]] && { had_skip=1; old_skip="$FLEET_SKIP_PERMISSIONS"; }
  FLEET_SKIP_PERMISSIONS=off; export FLEET_SKIP_PERMISSIONS
  # A codex companion is a READ-ONLY adversarial reviewer/standby. Plan mode's codex
  # default (--ask-for-approval untrusted) stops to ask "yes?" on nearly every command
  # and strands the pane (the "codex asks many questions" bug Roy hit with refuters).
  # Force the non-interactive read-only combo — same fix as cmd_refute — so it reviews
  # autonomously and never writes. A per-child manifest sandbox/approval_policy still
  # wins (fleet_codex_add_common_flags reads it via fleet_child_get, ahead of these env
  # defaults). Claude companions ignore these knobs.
  if [[ "$target_provider" == codex ]]; then
    [[ -n "${FLEET_CODEX_APPROVAL+x}" ]] && { had_capprove=1; old_capprove="$FLEET_CODEX_APPROVAL"; }
    [[ -n "${FLEET_CODEX_SANDBOX+x}"  ]] && { had_csandbox=1; old_csandbox="$FLEET_CODEX_SANDBOX"; }
    FLEET_CODEX_APPROVAL=never FLEET_CODEX_SANDBOX=read-only; export FLEET_CODEX_APPROVAL FLEET_CODEX_SANDBOX
  fi
  fleet_agent_build_args cargs "$target_provider" "$cid" "$cid" "$cwd" "$primer" "$prompt" "$sid" "$pm"
  if [[ "$target_provider" == codex ]]; then
    if [[ "$had_capprove" == 1 ]]; then FLEET_CODEX_APPROVAL="$old_capprove"; export FLEET_CODEX_APPROVAL; else unset FLEET_CODEX_APPROVAL; fi
    if [[ "$had_csandbox" == 1 ]]; then FLEET_CODEX_SANDBOX="$old_csandbox"; export FLEET_CODEX_SANDBOX; else unset FLEET_CODEX_SANDBOX; fi
  fi
  _fleet_restore_skip_permissions "$had_skip" "$old_skip"
  fleet_tmux_new_agent_window "$cid" "$cwd" "$exitfile" "$target_provider" cargs
  fleet_state_ensure "$cid" "$cwd" true
  summary="Adversarial read-only pair / failover standby for $base"
  fleet_state_jq "$cid" --arg p "$target_provider" --arg base "$base" --arg t "$summary" \
    '.state="running" | .reason=null | .provider=$p | .role="standby" | .pair_mode="read_only" | .writer=false | .companion_for=$base | .current_task=$t' >/dev/null
  fleet_log pair "$cid" "base=$base base_provider=$base_provider companion_provider=$target_provider source=$source mode=adversarial_read_only_standby"
  info "pair: '$base' ($base_provider writer) + '$cid' ($target_provider adversarial read-only standby)"
}

_fleet_pair_base() {
  local id="$1" base
  base="$(fleet_state_get "$id" '.companion_for' "")"
  [[ -n "$base" && "$base" != "null" ]] && { printf '%s\n' "$base"; return; }
  case "$id" in
    supervisor-claude|supervisor-codex) printf 'supervisor\n' ;;
    *-claude) printf '%s\n' "${id%-claude}" ;;
    *-codex)  printf '%s\n' "${id%-codex}" ;;
    *)        printf '%s\n' "$id" ;;
  esac
}

_fleet_pair_targets() {
  local base id expected; base="$(_fleet_pair_base "$1")"
  local -A seen=()
  for id in "$base" "$base-claude" "$base-codex"; do
    [[ -n "$id" && -z "${seen[$id]:-}" ]] || continue
    if fleet_tmux_has_window "$id" 2>/dev/null || [[ -f "$(fleet_state_path "$id")" ]]; then
      seen["$id"]=1
      printf '%s\n' "$id"
    fi
  done
  while IFS= read -r id; do
    [[ -n "$id" && -z "${seen[$id]:-}" ]] || continue
    expected="$(fleet_state_get "$id" '.companion_for' "")"
    [[ "$expected" == "$base" ]] || continue
    seen["$id"]=1
    printf '%s\n' "$id"
  done < <(fleet_state_ids)
}

cmd_pairs() {
  local only="${1:-}" base id provider live role task
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_reconcile
  printf '%s%-16s %-16s %-8s %-10s %-8s %s%s\n' "$c_bold" "PAIR" "LANE" "PROVIDER" "ROLE" "STATE" "TASK" "$c_reset"
  local -A bases=()
  if [[ -n "$only" ]]; then
    bases["$(_fleet_pair_base "$only")"]=1
  else
    bases["supervisor"]=1
    for base in "${CHILD_IDS[@]:-}"; do [[ -n "$base" ]] && bases["$base"]=1; done
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      base="$(_fleet_pair_base "$id")"
      [[ -n "$base" ]] && bases["$base"]=1
    done < <(fleet_state_ids)
  fi
  for base in "${!bases[@]}"; do
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      provider="$(_fleet_id_provider "$id")"
      live="$(faculty_liveness "$id")"
      role="$(fleet_state_get "$id" '.role' "")"
      task="$(fleet_state_get "$id" '.current_task' "")"; task="${task:0:48}"
      printf '  %-14s %-16s %-8s %-10s %-8s %s\n' "$base" "$id" "$provider" "${role:-writer}" "$live" "$task"
    done < <(_fleet_pair_targets "$base")
  done
}

_fleet_restore_skip_permissions() {
  local had="$1" old="$2"
  if [[ "$had" == "1" ]]; then FLEET_SKIP_PERMISSIONS="$old"; export FLEET_SKIP_PERMISSIONS
  else unset FLEET_SKIP_PERMISSIONS; fi
}

cmd_dispatch() {
  local provider_opt=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --provider) provider_opt="${2:?usage: fleet dispatch [--provider claude|codex] <id> \"<task>\" [cwd]}"; shift 2 ;;
      --claude) provider_opt="claude"; shift ;;
      --codex) provider_opt="codex"; shift ;;
      *) break ;;
    esac
  done
  [[ -n "$provider_opt" ]] && _fleet_validate_provider "$provider_opt"
  local id="${1:?usage: fleet dispatch [--provider claude|codex] <id> \"<task>\" [cwd]}"
  local task="${2:?provide a task prompt}" cwd_arg="${3:-}" cwd
  fleet_require_member_id "$id"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_has_tmux || die "tmux required for dispatch. Run: sudo apt install tmux"
  cwd="${cwd_arg:-$WORKSPACE}"; [[ "$cwd" != /* ]] && cwd="$WORKSPACE/$cwd"
  fleet_ensure_managed_settings
  fleet_tmux_ensure_session
  fleet_tmux_has_window "$id" && die "child '$id' already running — pick another id"
  local exitfile; exitfile="$(fleet_run_path "$id" .exit)" || return 1; rm -f "$exitfile"; mkdir -p "$RUN_DIR"
  local provider; provider="${provider_opt:-${FLEET_DISPATCH_PROVIDER:-$(fleet_default_provider)}}"
  local primer; primer="$(fleet_peer_primer "$id")"
  local -a cargs=()
  fleet_agent_build_args cargs "$provider" "$id" "$id" "$cwd" "$primer" "$task" "" ""
  fleet_tmux_new_agent_window "$id" "$cwd" "$exitfile" "$provider" cargs
  fleet_state_ensure "$id" "$cwd" true
  fleet_state_jq "$id" --arg t "$task" --arg p "$provider" '.state="running" | .current_task=$t | .provider=$p' >/dev/null
  fleet_log dispatch "$id" "$task"
  info "dispatched '$id' in $cwd — attach with: fleet attach $id"
}

cmd_init_resume() {
  local force=0 only=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --force) force=1; shift ;;
      -h|--help) die "usage: fleet init-resume [--force] [id]" ;;
      *) only="$1"; shift ;;
    esac
  done
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  local -a ids=()
  local id
  if [[ -n "$only" ]]; then
    ids=("$only")
  else
    ids=("${CHILD_IDS[@]:-}")
  fi
  [[ ${#ids[@]} -gt 0 ]] || die "no manifest children found; pass an id"
  for id in "${ids[@]}"; do
    [[ -n "$id" ]] || continue
    local cwd task f
    cwd="$(_fleet_id_cwd "$id")"
    [[ -d "$cwd" ]] || { warn "$id: cwd does not exist: $cwd"; continue; }
    f="$(_fleet_resume_path "$cwd")"
    if [[ -f "$f" && "$force" != "1" ]]; then
      info "kept   $f"
      continue
    fi
    task="$(fleet_state_get "$id" '.current_task' "")"
    _fleet_resume_template "$id" "$cwd" "$task" >"$f"
    info "wrote   $f"
  done
}

cmd_init_repo() {
  local only="${1:-}"
  [[ $# -le 1 ]] || die "usage: fleet init-repo [id]"
  [[ "$only" != "-h" && "$only" != "--help" ]] || die "usage: fleet init-repo [id]"

  fleet_load_paths
  [[ -f "$MANIFEST" ]] || die "no manifest: $MANIFEST"
  fleet_manifest_load "$MANIFEST"

  local -a ids=()
  local id found=0
  if [[ -n "$only" ]]; then
    for id in "${CHILD_IDS[@]:-}"; do
      [[ "$id" == "$only" ]] && { found=1; break; }
    done
    [[ "$found" == 1 ]] || die "unknown manifest child '$only'"
    ids=("$only")
  else
    ids=("${CHILD_IDS[@]:-}")
  fi
  [[ ${#ids[@]} -gt 0 ]] || die "no manifest children found"

  local srcdir="$TOOL_ROOT/templates/repo" cwd src dest fn hook hook_action
  [[ -d "$srcdir" ]] || die "missing repository templates: $srcdir"
  for id in "${ids[@]}"; do
    [[ -n "$id" ]] || continue
    cwd="$(_fleet_id_cwd "$id")"
    [[ -d "$cwd" ]] || { warn "$id: cwd does not exist: $cwd"; continue; }
    git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || { warn "$id: not a git repository: $cwd"; continue; }

    for fn in AGENTS.md DECISIONS.md RESUME.md; do
      src="$srcdir/$fn"
      dest="$cwd/$fn"
      [[ "$fn" == RESUME.md ]] && dest="$(_fleet_resume_path "$cwd")"
      if [[ -L "$dest" ]]; then
        warn "$id: refused symlink destination: $dest"
      elif [[ -e "$dest" ]]; then
        info "kept   $dest"
      else
        fleet_atomic_write "$dest" <"$src" || die "could not safely write $dest"
        info "wrote   $dest"
      fi
    done

    while read -r hook; do
      hook_action="$(fleet_install_git_hook "$cwd" "" "$hook")" || hook_action=notgit
      case "$hook_action" in
        current)   info "kept   $cwd/.git/hooks/$hook (current)" ;;
        updated)   info "updated $cwd/.git/hooks/$hook" ;;
        installed) info "wrote   $cwd/.git/hooks/$hook" ;;
        preserved) info "wrote   $cwd/.git/hooks/$hook (existing hook preserved and chained)" ;;
        *)         warn "$id: could not install $hook" ;;
      esac
    done < <(fleet_git_hook_names)
  done
  info "Complete every TODO(fleet-onboarding) before cross-repo or behavioural work."
}

cmd_pair() {
  local provider="" companion_id="" only=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --provider) provider="${2:?usage: fleet pair [--provider claude|codex] [--id companion-id] [id]}"; shift 2 ;;
      --claude) provider="claude"; shift ;;
      --codex) provider="codex"; shift ;;
      --id) companion_id="${2:?missing --id value}"; shift 2 ;;
      -h|--help) die "usage: fleet pair [--provider claude|codex] [--id companion-id] [id]" ;;
      *) only="$1"; shift ;;
    esac
  done
  [[ -n "$provider" ]] && _fleet_validate_provider "$provider"
  [[ -n "$companion_id" && -z "$only" ]] && die "--id requires a single base member id"

  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_has_tmux || die "tmux required for pair. Run: sudo apt install tmux"
  fleet_ensure_managed_settings
  fleet_tmux_ensure_session

  local -a bases=()
  local base
  # SC2190 misfires here: bases is declared -a (indexed) above; these are valid
  # indexed-array assignments, not associative ones.
  if [[ -n "$only" ]]; then
    # shellcheck disable=SC2190
    bases=("$only")
  else
    # shellcheck disable=SC2190
    bases=("${CHILD_IDS[@]:-}")
  fi
  [[ ${#bases[@]} -gt 0 ]] || die "no manifest children found; pass an id"

  for base in "${bases[@]}"; do
    _fleet_start_companion "$base" "$provider" "$companion_id" pair
  done
}

cmd_handoff() {
  local provider="" provider_forced=0 stop_source=0 task="" from="" to=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --provider) provider="${2:?usage: fleet handoff [--provider claude|codex] [--stop-source] <from> [to-id]}"; provider_forced=1; shift 2 ;;
      --claude) provider="claude"; provider_forced=1; shift ;;
      --codex) provider="codex"; provider_forced=1; shift ;;
      --stop-source|--down-source) stop_source=1; shift ;;
      --task) task="${2:?missing --task text}"; shift 2 ;;
      --id) to="${2:?missing --id value}"; shift 2 ;;
      -h|--help) die "usage: fleet handoff [--provider claude|codex] [--stop-source] <from> [to-id]" ;;
      *)
        if [[ -z "$from" ]]; then from="$1"
        elif [[ -z "$to" ]]; then to="$1"
        else die "usage: fleet handoff [--provider claude|codex] [--stop-source] <from> [to-id]"
        fi
        shift ;;
    esac
  done
  [[ -n "$from" ]] || die "usage: fleet handoff [--provider claude|codex] [--stop-source] <from> [to-id]"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  _fleet_guard_primary_lifecycle handoff "$from"
  fleet_has_tmux || die "tmux required for handoff. Run: sudo apt install tmux"

  local source_provider; source_provider="$(_fleet_id_provider "$from")"
  provider="${provider:-$(_fleet_opposite_provider "$source_provider")}"
  _fleet_validate_provider "$provider"
  if [[ -z "$to" ]]; then
    to="$(_fleet_live_companion_id "$from" "$provider" || true)"
    to="${to:-$from-$provider}"
  fi
  fleet_require_member_id "$from"; fleet_require_member_id "$to"
  [[ "$to" != "$from" ]] || die "handoff target id must differ from source id; use a new id like '$from-$provider'"

  local cwd; cwd="$(_fleet_id_cwd "$from")"
  [[ -d "$cwd" ]] || die "source '$from' cwd does not exist: $cwd"
  fleet_tmux_ensure_session

  fleet_ensure_managed_settings
  local primer prompt pm exitfile summary resume_sid="" stopped_source=0 promoting_standby=0
  local _sf; _sf="$(fleet_run_path "$to" .session)" && [[ -f "$_sf" ]] && resume_sid="$(<"$_sf")"
  if _fleet_is_readonly_standby "$to"; then
    promoting_standby=1
    [[ "${FLEET_HANDOFF_EXCLUSIVE:-on}" != "off" ]] && stop_source=1
    if [[ "$stop_source" == "1" ]]; then
      faculty_unmount "$from"
      fleet_state_jq "$from" --arg r "fleet handoff to $to" '.state="stopped" | .reason=$r' >/dev/null || true
      fleet_log down "$from" "handoff to $to"
      stopped_source=1
    fi
    if fleet_tmux_has_window "$to"; then
      faculty_unmount "$to"
      fleet_state_jq "$to" '.state="stopped" | .reason="promoting read-only standby for handoff"' >/dev/null || true
      fleet_log handoff "$to" "restarting read-only standby as takeover writer from=$from"
    fi
  fi
  if fleet_tmux_has_window "$to"; then
    local live_provider
    live_provider="$(_fleet_id_provider "$to")"
    if [[ "$provider_forced" == "1" && "$live_provider" != "$provider" ]]; then
      die "target '$to' is live as provider '$live_provider', not requested provider '$provider'"
    fi
    provider="$live_provider"
    prompt="$(_fleet_handoff_prompt "$from" "$to" "$source_provider" "$provider" "$task")"
    fleet_enqueue "$to" "$from" "$prompt" 1 handoff true
    local delivered="queued"
    faculty_deliver "$to" >/dev/null 2>&1 && delivered="delivered"
    summary="takeover from $from"
    [[ -n "$task" ]] && summary="$summary: ${task:0:120}"
    fleet_state_jq "$to" --arg p "$provider" --arg from "$from" --arg t "$summary" \
      '.state="running" | .reason=null | .provider=$p | .role="takeover" | .writer=true | .pair_mode="takeover" | .handoff_from=$from | .current_task=$t' >/dev/null
    fleet_log handoff "$to" "from=$from source_provider=$source_provider target_provider=$provider existing=true delivered=$delivered"
    if [[ "$stop_source" == "1" && "$stopped_source" == "0" ]]; then
      faculty_unmount "$from"
      fleet_state_jq "$from" --arg r "fleet handoff to $to" '.state="stopped" | .reason=$r' >/dev/null || true
      fleet_log down "$from" "handoff to $to"
    fi
    info "handoff: '$from' ($source_provider) -> live '$to' ($provider) [$delivered]"
    return 0
  fi

  primer="$(fleet_peer_primer "$to")"
  prompt="$(_fleet_handoff_prompt "$from" "$to" "$source_provider" "$provider" "$task")"
  pm="$(_fleet_takeover_permission_mode "$provider" "$from")"
  exitfile="$(fleet_run_path "$to" .exit)" || return 1; rm -f "$exitfile"; mkdir -p "$RUN_DIR"
  local -a cargs=()
  fleet_agent_build_args cargs "$provider" "$to" "$to" "$cwd" "$primer" "$prompt" "$resume_sid" "$pm"
  fleet_tmux_new_agent_window "$to" "$cwd" "$exitfile" "$provider" cargs
  fleet_state_ensure "$to" "$cwd" true
  summary="handoff from $from"
  [[ -n "$task" ]] && summary="$summary: ${task:0:120}"
  local target_role="handoff"
  [[ "$promoting_standby" == "1" ]] && target_role="takeover"
  fleet_state_jq "$to" --arg p "$provider" --arg from "$from" --arg t "$summary" --arg role "$target_role" \
    '.state="running" | .reason=null | .provider=$p | .role=$role | .writer=true | .pair_mode="takeover" | .handoff_from=$from | .current_task=$t' >/dev/null
  fleet_log handoff "$to" "from=$from source_provider=$source_provider target_provider=$provider"
  if [[ "$stop_source" == "1" && "$stopped_source" == "0" ]]; then
    faculty_unmount "$from"
    fleet_state_jq "$from" --arg r "fleet handoff to $to" '.state="stopped" | .reason=$r' >/dev/null || true
    fleet_log down "$from" "handoff to $to"
  fi
  info "handoff: '$from' ($source_provider) -> '$to' ($provider)"
  info "attach with: fleet attach $to"
}

cmd_failover() {
  local provider="codex" mode="exhausted" dry=0 explicit_targets=0 id source_provider role
  local -a targets=()
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --provider) provider="${2:?usage: fleet failover [--provider claude|codex] [--all|--exhausted] [id...]}"; shift 2 ;;
      --claude) provider="claude"; shift ;;
      --codex) provider="codex"; shift ;;
      --all) mode="all"; shift ;;
      --exhausted|--only-exhausted) mode="exhausted"; shift ;;
      --dry-run|-n) dry=1; shift ;;
      -h|--help) die "usage: fleet failover [--provider claude|codex] [--all|--exhausted] [id...]" ;;
      *) targets+=("$1"); explicit_targets=1; shift ;;
    esac
  done
  _fleet_validate_provider "$provider"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  # failover is a fleet-wide provider-lane coordination action; a read-only
  # companion/refuter may never initiate it (see _fleet_guard_primary_lifecycle).
  if [[ -n "${FLEET_CHILD_ID:-}" ]] && _fleet_actor_is_readonly_companion "${FLEET_CHILD_ID}"; then
    fleet_log security "${FLEET_CHILD_ID}" "DENIED failover — read-only companion/refuter may not run failover"
    die "refused: read-only companion/refuter '${FLEET_CHILD_ID}' may not run 'failover'. Only human root or the authorized primary can. (audit logged)"
  fi
  fleet_has_tmux || die "tmux required for failover. Run: sudo apt install tmux"
  fleet_ensure_managed_settings
  fleet_tmux_ensure_session

  if [[ ${#targets[@]} -eq 0 ]]; then
    if [[ "$mode" == "all" ]]; then
      targets=("${CHILD_IDS[@]:-}")
    else
      while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        source_provider="$(_fleet_id_provider "$id")"
        [[ "$source_provider" != "$provider" ]] || continue
        fleet_tmux_has_window "$id" 2>/dev/null || continue
        fleet_pane_is_provider_exhausted "$id" 2>/dev/null || continue
        targets+=("$id")
      done < <(printf '%s\n' "${CHILD_IDS[@]:-}")
    fi
  fi
  [[ ${#targets[@]} -gt 0 ]] || { info "failover: no ${mode} source lanes found for provider '$provider'"; return 0; }

  local acted=0 skipped=0
  for id in "${targets[@]}"; do
    [[ -n "$id" ]] || continue
    if fleet_is_supervisor_id "$id"; then
      if [[ "$dry" == "1" ]]; then
        info "failover: would ensure supervisor companion for '$id'"
      else
        fleet_start_supervisor_companion
        info "failover: ensured supervisor companion"
      fi
      acted=$(( acted + 1 ))
      continue
    fi
    if _fleet_manifest_marks_companion "$id"; then
      info "failover: skip '$id' (manifest marks it as companion)"
      skipped=$(( skipped + 1 ))
      continue
    fi
    role="$(fleet_state_get "$id" '.role' "")"
    case "$role" in
      standby|adversary)
        info "failover: skip '$id' (role=$role)"
        skipped=$(( skipped + 1 ))
        continue ;;
    esac
    source_provider="$(_fleet_id_provider "$id")"
    if [[ "$source_provider" == "$provider" ]]; then
      info "failover: skip '$id' (already provider=$provider)"
      skipped=$(( skipped + 1 ))
      continue
    fi
    if [[ "$mode" == "exhausted" && "$explicit_targets" != "1" ]]; then
      if ! fleet_tmux_has_window "$id" 2>/dev/null || ! fleet_pane_is_provider_exhausted "$id" 2>/dev/null; then
        info "failover: skip '$id' (not live provider-exhausted)"
        skipped=$(( skipped + 1 ))
        continue
      fi
    fi
    if [[ "$dry" == "1" ]]; then
      info "failover: would handoff '$id' ($source_provider) -> $provider"
    else
      info "failover: handoff '$id' ($source_provider) -> $provider"
      cmd_handoff --provider "$provider" --stop-source "$id"
    fi
    acted=$(( acted + 1 ))
  done
  info "failover: acted=$acted skipped=$skipped provider=$provider mode=$mode"
}

cmd_refute() {
  local provider="" reviewer="" lens="" claim="" target="" diff_ref=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --provider) provider="${2:?usage: fleet refute [--provider claude|codex] [--id id] <target> [claim]}"; shift 2 ;;
      --claude) provider="claude"; shift ;;
      --codex) provider="codex"; shift ;;
      --id) reviewer="${2:?missing --id value}"; shift 2 ;;
      --lens) lens="${2:?missing --lens text}"; shift 2 ;;
      --claim|--task) claim="${2:?missing claim text}"; shift 2 ;;
      --diff) diff_ref="${2:?missing diff ref}"; shift 2 ;;
      -h|--help) die "usage: fleet refute [--provider claude|codex] [--id id] <target> [claim]" ;;
      *)
        if [[ -z "$target" ]]; then target="$1"
        else claim="${claim:+$claim }$1"
        fi
        shift ;;
    esac
  done
  [[ -n "$target" ]] || die "usage: fleet refute [--provider claude|codex] [--id id] <target> [claim]"
  fleet_require_member_id "$target"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_has_tmux || die "tmux required for refute. Run: sudo apt install tmux"

  local target_provider; target_provider="$(_fleet_id_provider "$target")"
  provider="${provider:-$(_fleet_opposite_provider "$target_provider")}"
  _fleet_validate_provider "$provider"
  reviewer="${reviewer:-$target-$provider-refute}"
  fleet_require_member_id "$reviewer"
  [[ "$reviewer" != "$target" ]] || die "reviewer id must differ from target id"

  local cwd; cwd="$(_fleet_id_cwd "$target")"
  [[ -d "$cwd" ]] || die "target '$target' cwd does not exist: $cwd"
  fleet_tmux_ensure_session
  fleet_tmux_has_window "$reviewer" && die "reviewer '$reviewer' already has a live window"

  fleet_ensure_managed_settings
  local primer prompt exitfile had_skip=0 old_skip=""
  primer="$(fleet_peer_primer "$reviewer")"
  prompt="$(_fleet_refute_prompt "$target" "$reviewer" "$target_provider" "$provider" "$lens" "$claim" "$diff_ref")"
  exitfile="$(fleet_run_path "$reviewer" .exit)" || return 1; rm -f "$exitfile"; mkdir -p "$RUN_DIR"
  [[ -n "${FLEET_SKIP_PERMISSIONS+x}" ]] && { had_skip=1; old_skip="$FLEET_SKIP_PERMISSIONS"; }
  FLEET_SKIP_PERMISSIONS=off; export FLEET_SKIP_PERMISSIONS
  # A refuter is READ-ONLY (it never writes), but read-only must not mean PROMPTING: the
  # Codex default for plan mode is `--ask-for-approval untrusted`, which stops to ask "yes?"
  # on essentially every command and strands the pane (Roy: "codex asks many questions that
  # just require a yes"). Force NON-interactive read-only — approval `never` + a read-only
  # sandbox — so it runs its read/analysis commands autonomously and any write is denied by
  # the sandbox rather than prompted. (Codex-only knobs; the Claude refuter ignores them.)
  local had_capprove=0 old_capprove="" had_csandbox=0 old_csandbox=""
  [[ -n "${FLEET_CODEX_APPROVAL+x}" ]] && { had_capprove=1; old_capprove="$FLEET_CODEX_APPROVAL"; }
  [[ -n "${FLEET_CODEX_SANDBOX+x}"  ]] && { had_csandbox=1; old_csandbox="$FLEET_CODEX_SANDBOX"; }
  FLEET_CODEX_APPROVAL=never FLEET_CODEX_SANDBOX=read-only; export FLEET_CODEX_APPROVAL FLEET_CODEX_SANDBOX
  # shellcheck disable=SC2034  # cargs is populated + consumed by nameref below
  local -a cargs=()
  fleet_agent_build_args cargs "$provider" "$reviewer" "$reviewer" "$cwd" "$primer" "$prompt" "" "plan"
  _fleet_restore_skip_permissions "$had_skip" "$old_skip"
  if [[ "$had_capprove" == 1 ]]; then FLEET_CODEX_APPROVAL="$old_capprove"; export FLEET_CODEX_APPROVAL; else unset FLEET_CODEX_APPROVAL; fi
  if [[ "$had_csandbox" == 1 ]]; then FLEET_CODEX_SANDBOX="$old_csandbox"; export FLEET_CODEX_SANDBOX; else unset FLEET_CODEX_SANDBOX; fi
  fleet_tmux_new_agent_window "$reviewer" "$cwd" "$exitfile" "$provider" cargs
  fleet_state_ensure "$reviewer" "$cwd" true
  fleet_state_jq "$reviewer" --arg p "$provider" --arg target "$target" \
    '.state="running" | .reason=null | .provider=$p | .role="adversary" | .refutes=$target | .companion_for=$target | .current_task=("Adversarial review of " + $target)' >/dev/null
  fleet_log refute "$reviewer" "target=$target target_provider=$target_provider reviewer_provider=$provider"
  info "refute: '$reviewer' ($provider) is reviewing '$target' ($target_provider) read-only"
  info "attach with: fleet attach $reviewer"
}

cmd_attach() {
  local id="${1:?usage: fleet attach <id>}"
  fleet_load_paths
  fleet_tmux_has_window "$id" || die "no live window for '$id' (try 'fleet status')"
  fleet_tmux select-window -t "$FLEET_TMUX_SESSION:$id" 2>/dev/null || true
  # switch-client only when we're already inside the fleet's own server; from any
  # other tmux (the user's personal one, a different socket) attach nested with
  # TMUX unset so tmux allows it.
  if [[ -n "${TMUX:-}" && "${TMUX%%,*}" == */"$FLEET_TMUX_SOCKET" ]]; then
    fleet_tmux switch-client -t "$FLEET_TMUX_SESSION:$id"
  else
    env -u TMUX tmux -L "$FLEET_TMUX_SOCKET" attach -t "$FLEET_TMUX_SESSION" \; select-window -t "$id"
  fi
}

cmd_reap() {
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  local id reaped=0
  for id in "${CHILD_IDS[@]:-}"; do
    [[ -n "$id" ]] || continue
    # a managed child that is down but not intentionally stopped → crashed.
    # "down" = no window, OR (under remain-on-exit) a window whose pane has DIED —
    # otherwise a lingering dead pane would be mistaken for a live worker and skipped.
    if fleet_tmux_has_window "$id" 2>/dev/null && ! fleet_tmux_pane_dead "$id" 2>/dev/null; then
      continue
    fi
    local st; st="$(fleet_state_get "$id" '.state' unknown)"
    [[ "$st" == "stopped" || "$st" == "failed" ]] && continue
    [[ "$st" == "running" ]] || continue
    local _rc; _rc="$(fleet_child_exit_code "$id" 2>/dev/null || true)"
    warn "child '$id' is down (rc=${_rc:-?}) — applying policy"
    if fleet_restart_child "$id"; then reaped=$(( reaped + 1 )); fi
  done
  (( reaped == 0 )) && info "reap: nothing to restart"
}

# --- health: fleet doctor ---------------------------------------------------
# Self-check the oversight wire from GROUND TRUTH and report (or, with --quiet,
# just exit non-zero) when an invariant is broken. Asserts, per live child:
#   * a state doc with a session_id exists (reconcile should guarantee this);
#   * no inbox line has been delivered==false longer than FLEET_MAIL_STALE_SECS;
#   * sum(.inject_failures)==0 (the honest-inbox failure counter is clear);
# Optional watchdog utilities are not doctor invariants: they are not fleet-managed,
# and a global process-name check is wrong when several workspaces run at once. A worker blocked on an API
# rate-limit is reported as THROTTLED (healthy-but-waiting), kept DISTINCT from
# idle/dead so it is never mistaken for stuck/dead and restarted. A worker blocked
# on hard provider credits/quota is reported separately because retry nudges will
# not fix it; it needs operator/admin action or cross-provider handoff.
FLEET_MAIL_STALE_SECS="${FLEET_MAIL_STALE_SECS:-300}"
# fleet tokens — per-worker CONTEXT size (the per-turn token cost that drives
# rate-limits / running-out). Reads each live worker's transcript tail
# (fleet_ctx_tokens), shows tokens, % of the context ceiling, liveness, and a
# throttled/heavy note. The supervisor checks this each sweep (SUPERVISOR.md) and
# `fleet compact`s a worker pinned heavy; the human runs it ad hoc.
cmd_tokens() {
  fleet_load_paths
  [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_reconcile
  local ceil="${FLEET_CTX_CEILING:-1000000}" warn="${FLEET_CTX_WARN_PCT:-90}"
  local -A seen=(); local -a ids=(); local id
  for id in "${CHILD_IDS[@]:-}"; do [[ -n "$id" ]] || continue; seen["$id"]=1; ids+=("$id"); done
  while read -r id; do [[ -n "$id" && -z "${seen[$id]:-}" ]] && { seen["$id"]=1; ids+=("$id"); }; done < <(fleet_state_ids)
  printf '%s%-14s %12s %6s %-7s %s%s\n' "$c_bold" "CHILD" "CTX(tok)" "%CEIL" "STATE" "NOTE" "$c_reset"
  local sum=0 ctx pct live note
  for id in "${ids[@]}"; do
    [[ -n "$id" ]] || continue
    fleet_tmux_has_window "$id" 2>/dev/null || continue      # only a live window has a current ctx
    ctx="$(fleet_ctx_tokens "$id" 2>/dev/null)" || ctx=0; [[ "$ctx" =~ ^[0-9]+$ ]] || ctx=0
    (( ctx == 0 )) && continue
    sum=$(( sum + ctx )); pct=$(( ctx * 100 / ceil ))
    live="$(faculty_liveness "$id" 2>/dev/null)"
    note=""
    fleet_pane_is_throttled "$id" 2>/dev/null && note="throttled"
    (( pct >= warn )) && note="${note:+$note, }heavy→compact"
    printf '  %-14s %12s %5d%% %-7s %s\n' "$id" "$ctx" "$pct" "$live" "$note"
  done
  printf '  %-14s %12s   (sum across live workers; ceiling=%s, warn=%s%%)\n' "(total)" "$sum" "$ceil" "$warn"
}

# fleet compact [id | --all] [--force] — inject /compact into a worker to bound its
# context. Only compacts a worker IDLE at its prompt (safe) unless --force. The
# supervisor uses this on a worker `fleet tokens` shows pinned heavy.
cmd_compact() {
  fleet_load_paths
  [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  local force=0 all=0
  while [[ $# -gt 0 ]]; do case "$1" in --force|-f) force=1; shift ;; --all) all=1; shift ;; -h|--help) die "usage: fleet compact <id> | --all [--force]" ;; *) break ;; esac; done
  local -a targets=()
  if [[ "$all" == 1 ]]; then
    fleet_reconcile; local x; while read -r x; do [[ -n "$x" ]] && fleet_tmux_has_window "$x" 2>/dev/null && targets+=("$x"); done < <(fleet_state_ids)
  else
    [[ -n "${1:-}" ]] || die "usage: fleet compact <id> | --all [--force]"
    targets=("$1")
  fi
  local t rc=0
  for t in "${targets[@]}"; do
    if ! fleet_tmux_has_window "$t" 2>/dev/null; then warn "compact: '$t' has no live window"; rc=1; continue; fi
    if [[ "$force" != 1 ]] && declare -F fleet_pane_is_idle >/dev/null 2>&1 && ! fleet_pane_is_idle "$t" 2>/dev/null; then
      warn "compact: '$t' is busy (not at an idle prompt) — skipped; --force to compact anyway"; rc=1; continue
    fi
    if fleet_compact "$t"; then info "compact: sent /compact to '$t'"; else warn "compact: send failed for '$t'"; rc=1; fi
  done
  return $rc
}

cmd_doctor() {
  local quiet=0
  while [[ $# -gt 0 ]]; do case "$1" in --quiet|-q) quiet=1; shift ;; *) shift ;; esac; done
  fleet_load_paths
  [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_reconcile

  local -a problems=()
  local now; now="$(date +%s)"

  # enumerate the same id set status uses (ground-truth union).
  local -A seen=(); local -a ids=(); local id
  for id in "${CHILD_IDS[@]:-}"; do [[ -n "$id" ]] || continue; seen["$id"]=1; ids+=("$id"); done
  while read -r id; do [[ -n "$id" && -z "${seen[$id]:-}" ]] && { seen["$id"]=1; ids+=("$id"); }; done < <(fleet_state_ids)
  local -A MAN=(); for id in "${CHILD_IDS[@]:-}"; do [[ -n "$id" ]] && MAN["$id"]=1; done
  local -A RESUME_CHECKED=() GIT_SYNC_CHECKED=() ONBOARDING_CHECKED=()

  # --- hook drift: deployed .git/hooks/* vs source-of-truth ------------------
  # THE check that would have caught this class. The git hooks were hand-copied once and
  # never synced, so source could gain a scan (the MAC-value check) while every repo kept
  # running the old file — and every gate still reported CLEAN. An un-installed hook
  # protects nothing, and nothing was watching. Hash-compare makes that impossible to miss.
  # Advisory-shaped like the rest of doctor: reports, never installs. Toggle:
  # FLEET_HOOK_DRIFT_CHECK=off
  if [[ "${FLEET_HOOK_DRIFT_CHECK:-on}" != "off" ]]; then
    local _hsrc; _hsrc="$(fleet_git_hook_src)"
    if [[ -f "$_hsrc" ]]; then
      local _rid _rcwd _st _hook; local -A _repo_seen=()
      for _rid in "${ids[@]}"; do
        [[ -n "$_rid" ]] || continue
        if [[ -n "${MAN[$_rid]:-}" ]]; then
          _rcwd="$(fleet_child_get "$_rid" cwd "")"
        elif fleet_tmux_has_window "$_rid" 2>/dev/null; then
          _rcwd="$(fleet_state_get "$_rid" '.cwd' "")"
        else
          continue
        fi
        [[ -n "$_rcwd" ]] || continue
        [[ "$_rcwd" != /* ]] && _rcwd="$WORKSPACE/$_rcwd"
        _rcwd="$(cd "$_rcwd" 2>/dev/null && pwd -P)" || continue
        [[ -n "${_repo_seen[$_rcwd]:-}" ]] && continue
        _repo_seen["$_rcwd"]=1
        while read -r _hook; do
          _st="$(fleet_hook_drift_state "$_rcwd" "$_hook" 2>/dev/null)" || _st=notgit
          case "$_st" in
            drift-stale)    problems+=("$(basename "$_rcwd"): deployed $_hook hook is BEHIND source-of-truth (run: fleet install-git-hooks)") ;;
            drift-tampered) problems+=("$(basename "$_rcwd"): deployed $_hook hook declares the same version as source but differs (run: fleet install-git-hooks)") ;;
            # ‼ NO REMEDY IS OFFERED HERE ON PURPOSE. The deployed copy is NEWER, so the
            #   obvious remedy is a downgrade — see lib/githooks.sh fleet_hook_drift_state.
            drift-ahead)    problems+=("$(basename "$_rcwd"): deployed $_hook hook is AHEAD of source-of-truth — DO NOT install-git-hooks, that would DOWNGRADE it; promote the deployed hook into the tool instead") ;;
            drift-unknown)  problems+=("$(basename "$_rcwd"): deployed $_hook hook differs from source and neither declares a readable version — direction UNKNOWN, diff before acting") ;;
            missing)        problems+=("$(basename "$_rcwd"): no $_hook hook installed (run: fleet install-git-hooks)") ;;
          esac
        done < <(fleet_git_hook_names)
      done
    fi
  fi

  local total_inject_failures=0
  local -a throttled=() exhausted=() heavy=()
  for id in "${ids[@]}"; do
    [[ -n "$id" ]] || continue
    local has_win=0; fleet_tmux_has_window "$id" 2>/dev/null && has_win=1

    # context-heavy advisory (near the ceiling = a compaction candidate). Informational,
    # NOT a problem: proactive /compact + Claude auto-compact resolve it on their own. It
    # is surfaced so a worker PINNED heavy (never idling to auto-compact) can be
    # `fleet compact`ed. Kept out of the --quiet digest so it never spams the supervisor.
    if [[ "$has_win" == 1 ]]; then
      # fleet_ctx_tokens returns non-zero when a worker has no transcript yet; swallow it
      # so set -e doesn't abort doctor mid-loop (it worked live only because real workers
      # have transcripts — smoke's windowed-but-transcript-less workers exposed this).
      local cx; cx="$(fleet_ctx_tokens "$id" 2>/dev/null)" || cx=0; [[ "$cx" =~ ^[0-9]+$ ]] || cx=0
      (( cx >= ${FLEET_CTX_WARN_TOKENS:-900000} )) && heavy+=("$id(${cx})")
    fi

    # hard usage/credits exhaustion is actionable, but not a restart condition.
    if [[ "$has_win" == 1 ]] && fleet_pane_is_provider_exhausted "$id"; then
      exhausted+=("$id")
      problems+=("$id: provider usage/credits exhausted; request quota or hand off to another provider")
    fi

    # throttle is reported but is NOT a problem (worker is healthy-but-waiting).
    if [[ "$has_win" == 1 ]] && fleet_pane_is_throttled "$id"; then throttled+=("$id"); fi

    # live window ⇒ a state doc with a session_id must exist.
    if [[ "$has_win" == 1 ]]; then
      local sf; sf="$(fleet_state_path "$id")" || sf=""
      if [[ ! -f "$sf" ]]; then
        problems+=("$id: live window but NO state doc (reconcile failed)")
      else
        local sid; sid="$(fleet_state_get "$id" '.session_id' "")"
        [[ -z "$sid" || "$sid" == "null" ]] && problems+=("$id: live window but state doc has no session_id")
      fi
    fi

    # Runtime mail health matters only while a child is live. Stopped/dead state is
    # history, not an active delivery path; treating it as current makes a copied or
    # restarted workspace permanently red over mail no process can consume.
    # `|| inbox=""` is load-bearing: bin/fleet runs `set -euo pipefail`, and
    # fleet_inbox_file now returns non-zero for a junk id (e.g. the '--help' phantom
    # that lives in real state dirs). A bare assignment would abort doctor ENTIRELY
    # and silently — fail-closed must not become fail-fatal. The -f guard below then
    # does the closing.
    local inf=0 inbox=""
    if [[ "$has_win" == 1 ]]; then
      inf="$(fleet_state_get "$id" '.inject_failures' 0)"; [[ "$inf" =~ ^[0-9]+$ ]] || inf=0
      (( inf > 0 )) && { problems+=("$id: $inf unverified inject failure(s) (mail may be stranded)"); total_inject_failures=$(( total_inject_failures + inf )); }
      inbox="$(fleet_inbox_file "$id" 2>/dev/null)" || inbox=""
    fi
    if [[ -n "$inbox" && -f "$inbox" ]]; then
      local oldest; oldest="$(jq -s --argjson now "$now" '
        [.[] | select(.delivered==false) | ($now - (.ts // $now))] | (max // 0)' "$inbox" 2>/dev/null || echo 0)"
      [[ "$oldest" =~ ^[0-9]+$ ]] || oldest=0
      if (( oldest > FLEET_MAIL_STALE_SECS )); then
        # Throttled/exhausted targets legitimately can't receive yet — don't flag
        # their mail as stale; report the provider condition instead.
        if [[ " ${throttled[*]:-} " != *" $id "* && " ${exhausted[*]:-} " != *" $id "* ]]; then
          problems+=("$id: undelivered mail ${oldest}s old (> ${FLEET_MAIL_STALE_SECS}s stale)")
        fi
      fi
    fi

    # Repo-local handoff state: every managed implementation worker needs a
    # durable RESUME.md so another provider can take over without private
    # transcript access. Adversarial reviewers are intentionally read-only and
    # excluded.
    local managed cwd rel role resume_problem resume_key
    managed="$(fleet_state_get "$id" '.managed' false)"
    if [[ -n "${MAN[$id]:-}" || ( "$managed" == "true" && "$has_win" == 1 ) ]]; then
      if [[ -n "${MAN[$id]:-}" ]]; then
        rel="$(fleet_child_get "$id" cwd "")"
        [[ -n "$rel" ]] && { cwd="$WORKSPACE/$rel"; [[ "$rel" == /* ]] && cwd="$rel"; }
      else
        cwd="$(fleet_state_get "$id" '.cwd' "")"
      fi
      if [[ -n "$cwd" && "$cwd" != "null" ]]; then
        if [[ -z "${GIT_SYNC_CHECKED[$cwd]:-}" ]]; then
          GIT_SYNC_CHECKED["$cwd"]=1
          local git_sync_problem
          git_sync_problem="$(_fleet_git_sync_problem "$id" "$cwd")"
          [[ -n "$git_sync_problem" ]] && problems+=("$git_sync_problem")
        fi
        role="$(fleet_state_get "$id" '.role' "")"
        if [[ "$id" != "supervisor" && "$role" != "adversary" ]]; then
          if [[ -z "${ONBOARDING_CHECKED[$cwd]:-}" ]]; then
            ONBOARDING_CHECKED["$cwd"]=1
            local onboarding_problem
            onboarding_problem="$(_fleet_repo_onboarding_problem "$id" "$cwd")"
            [[ -n "$onboarding_problem" ]] && problems+=("$onboarding_problem")
          fi
          resume_key="$cwd"
          if [[ -z "${RESUME_CHECKED[$resume_key]:-}" ]]; then
            RESUME_CHECKED["$resume_key"]=1
            resume_problem="$(_fleet_resume_status_problem "$id" "$cwd")"
            [[ -n "$resume_problem" ]] && problems+=("$resume_problem")
          fi
        fi
      fi
    fi
  done

  if [[ "$quiet" == 1 ]]; then
    [[ ${#problems[@]} -eq 0 ]] && return 0
    # compact, single-line summary for the watchdog → supervisor note.
    printf '%s\n' "$(IFS='; '; printf '%s' "${problems[*]}")"
    return 1
  fi

  printf '%sfleet doctor%s\n' "$c_bold" "$c_reset"
  if [[ ${#throttled[@]} -gt 0 ]]; then
    printf '  %sthrottled%s (API rate-limit; healthy, NOT restarted): %s\n' "$c_yel" "$c_reset" "${throttled[*]}"
  fi
  if [[ ${#exhausted[@]} -gt 0 ]]; then
    printf '  %sexhausted%s (provider usage/credits; handoff or request quota): %s\n' "$c_red" "$c_reset" "${exhausted[*]}"
  fi
  if [[ ${#heavy[@]} -gt 0 ]]; then
    printf '  %sheavy-context%s (near ceiling; `fleet compact <id>` if pinned, else auto-compacts): %s\n' "$c_yel" "$c_reset" "${heavy[*]}"
  fi
  if [[ ${#problems[@]} -eq 0 ]]; then
    printf '  %sok%s   all invariants hold (%d child(ren), inject_failures=%d)\n' "$c_grn" "$c_reset" "${#ids[@]}" "$total_inject_failures"
    return 0
  fi
  local p
  for p in "${problems[@]}"; do printf '  %sFAIL%s %s\n' "$c_red" "$c_reset" "$p"; done
  return 1
}

# --- inter-agent comms ------------------------------------------------------
# `ask` (cmd_ask) answers off-thread via a provider-native responder. `send` delivers a
# brief FYI into the target's live thread via _fleet_deliver below.
# _fleet_parse_msg sets _F_FROM/_F_TO/_F_TEXT from [--from] <to> [text].
#
# --file <path> / --file - (stdin) reads the BODY OUT OF BAND. Use it for anything
# longer than a line.
#
# WHY IT EXISTS (2026-07-17, hive; tallied across one night: composer mangled 4 sends,
# core mangled 3 — twice inside messages ABOUT rigour — hive mangled a commit). Passing
# a message as a shell WORD makes the text a shell TOKEN, so backticks, $(…), $VAR,
# braces, globs and quotes are all live. Every mitigation we tried — "avoid backticks",
# "use single quotes", "prose only" — is DISCIPLINE: a rule you must recall at the exact
# moment your attention is on the thing you are reporting, WHICH IS THE MOMENT IT FAILS.
# It failed 7+ times to lanes who could all recite it.
#
# ★ AND THE DANGEROUS CASE HAS NO TELL. A mangled backtick throws a parse error and you
# see it. AN UNSET $VAR EXPANDS TO EMPTY: the clause VANISHES, exit code 0, the message
# delivers, and the recipient reads something COHERENT WITH A HOLE IN IT and cannot know.
# The channel carrying our fail-silent-while-green findings had the identical defect, and
# an eaten clause leaves no evidence at EITHER end.
#
# THE DISCRIMINATOR IS NOT QUOTING STYLE — IT IS WHETHER THE TEXT IS EVER A SHELL TOKEN.
# Read from a file and it never is: it is DATA FROM BIRTH. That is a CONSTRUCTION, not a
# rule, so it cannot be forgotten under load. (hive's `"$(cat body)"` form works for the
# same reason — command-substitution output is not re-scanned for metacharacters — but it
# still requires REMEMBERING to use it. This makes the safe path a flag.)
_fleet_parse_msg() {
  _F_FROM=""; local rest=() _f_file=""
  while [[ $# -gt 0 ]]; do case "$1" in
    --from) _F_FROM="$2"; shift 2 ;;
    --file) _f_file="$2"; shift 2 ;;
    *) rest+=("$1"); shift ;;
  esac; done
  set -- "${rest[@]}"
  _F_TO="${1:-}"; _F_TEXT="${2:-}"
  if [[ -n "$_f_file" ]]; then
    [[ -n "$_F_TEXT" ]] && die "give the body EITHER as an argument OR via --file, not both"
    if [[ "$_f_file" == "-" ]]; then _F_TEXT="$(cat)"
    else [[ -r "$_f_file" ]] || die "--file: cannot read '$_f_file'"; _F_TEXT="$(cat -- "$_f_file")"; fi
    [[ -n "$_F_TEXT" ]] || die "--file: '$_f_file' is empty — refusing to send a blank message"
  fi
  [[ -z "$_F_FROM" ]] && _F_FROM="${FLEET_CHILD_ID:-supervisor}"
  # Both ids become path components (inbox/<id>.jsonl) and tmux targets. --from is
  # picked by whichever agent is calling and was previously never checked, so validate
  # here: the single boundary every messaging command funnels through. An EMPTY _F_TO
  # is left to the callers' usage message rather than pre-empted with "invalid id".
  # _F_TO MAY be a comma-separated list (multi-recipient send). Validate EACH id, so
  # the single boundary every messaging command funnels through keeps doing its job —
  # a list must not smuggle an unvalidated component past the path/tmux checks. Commands
  # that accept only one recipient still see the raw string and reject a list themselves.
  if [[ -n "$_F_TO" ]]; then
    local _v_list=() _v
    IFS=',' read -r -a _v_list <<< "$_F_TO"
    for _v in "${_v_list[@]}"; do
      _v="${_v#"${_v%%[![:space:]]*}"}"; _v="${_v%"${_v##*[![:space:]]}"}"
      fleet_require_member_id "$_v"
    done
  fi
  fleet_require_member_id "$_F_FROM"
}
_fleet_known_recipient() {  # is <id> a lane we could plausibly reach?
  local to="$1"
  local f
  fleet_tmux_has_window "$to" && return 0                        # live or stale window
  [[ -n "$(fleet_child_get "$to" cwd "")" ]] && return 0         # manifest member
  f="$(fleet_state_path "$to")" 2>/dev/null || f=""
  [[ -n "$f" && -f "$f" ]] && return 0                           # known ad-hoc/retired lane
  f="$(fleet_inbox_file "$to")" 2>/dev/null || return 1
  [[ -n "$f" && -f "$f" ]] && return 0                           # retired member, has mail history
  return 1
}

_fleet_deliver() {   # <kind> <to> <from> <text>
  local kind="$1" to="$2" from="$3" text="$4"
  [[ "$to" == "$from" ]] && die "cannot $kind to self ($to)"
  # FAIL CLOSED ON AN UNKNOWN RECIPIENT. fleet_require_member_id validates the id
  # FORMAT (path safety) — it does NOT check membership, so any well-formed string
  # was accepted: a mailbox got fabricated, "→ queued for 'X'" printed, exit 0, and
  # the message went nowhere with delivered:false forever. A typo'd lane name was
  # indistinguishable from a real one, and "queued" was never evidence of delivery.
  # Measured 2026-07-19: `fleet send nonexistent-lane` returned 0 and created
  # .fleet/inbox/nonexistent-lane.jsonl. Known-but-stopped lanes still resolve (they
  # keep a mailbox), so replying to a retired member is unaffected.
  # Override for a deliberately pre-created lane: FLEET_ALLOW_UNKNOWN_RECIPIENT=1
  if [[ "${FLEET_ALLOW_UNKNOWN_RECIPIENT:-0}" != "1" ]] && ! _fleet_known_recipient "$to"; then
    die "unknown recipient '$to' — no window, no manifest entry, no mailbox. Check the id (fleet status), or set FLEET_ALLOW_UNKNOWN_RECIPIENT=1 to pre-create it."
  fi
  text="$(_fleet_authority_tag "$from")$text"   # provenance prefix (companion → advisory)
  local cap; cap="$(fleet_max_hops)"
  local hop; hop="$(fleet_next_hop "$from")" || {
    fleet_log hop-limit "$to" "from=$from cap=$cap"
    die "hop limit ($cap) reached for this thread — not sent to '$to'. Start a fresh thread, or raise [supervisor] max_hops."
  }
  fleet_enqueue "$to" "$from" "$text" "$hop" "$kind"
  fleet_log "$kind" "$to" "from=$from hop=$hop"
  # deliver call site — routed through the transport seam (tmux branch IS
  # fleet_drain_inbox; behaviour identical).
  if faculty_deliver "$to"; then
    info "→ delivered to '$to' (from $from, hop $hop/$cap) — it's in '$to's thread now"
  else
    info "→ queued for '$to' (busy/offline, hop $hop/$cap) — lands in its thread when it's next at its prompt"
  fi
}

cmd_pair_send() {
  _fleet_parse_msg "$@"
  [[ -n "$_F_TO" && -n "$_F_TEXT" ]] || die "usage: fleet pair-send <pair-id> \"<msg>\" [--from <id>]"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  _fleet_guard_messaging pair "$_F_FROM"   # authority before operational checks
  fleet_has_tmux || die "tmux required. Run: sudo apt install tmux"
  local pair="$_F_TO" from="$_F_FROM" text="$_F_TEXT" to sent=0 queued=0
  local -a targets=()
  mapfile -t targets < <(_fleet_pair_targets "$pair")
  [[ ${#targets[@]} -gt 0 ]] || die "unknown pair '$pair'"
  local cap hop
  cap="$(fleet_max_hops)"
  hop="$(fleet_next_hop "$from")" || {
    fleet_log hop-limit "$pair" "from=$from cap=$cap"
    die "hop limit ($cap) reached for this thread — not sent to pair '$pair'. Start a fresh thread, or raise [supervisor] max_hops."
  }
  for to in "${targets[@]}"; do
    [[ -n "$to" && "$to" != "$from" ]] || continue
    fleet_enqueue "$to" "$from" "$text" "$hop" msg
    fleet_log msg "$to" "pair=$pair from=$from hop=$hop"
    if faculty_deliver "$to"; then sent=$(( sent + 1 )); else queued=$(( queued + 1 )); fi
  done
  (( sent + queued > 0 )) || die "pair '$pair' has no recipient other than '$from'"
  info "→ pair '$(_fleet_pair_base "$pair")': delivered=$sent queued=$queued (from $from, hop $hop/$cap)"
}

cmd_pair_ask() {
  _fleet_parse_msg "$@"
  [[ -n "$_F_TO" && -n "$_F_TEXT" ]] || die "usage: fleet pair-ask <pair-id> \"<question>\" [--from <id>]"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_has_tmux || die "tmux required. Run: sudo apt install tmux"
  local pair="$_F_TO" from="$_F_FROM" q="$_F_TEXT" to asked=0
  local -a targets=()
  mapfile -t targets < <(_fleet_pair_targets "$pair")
  [[ ${#targets[@]} -gt 0 ]] || die "unknown pair '$pair'"
  for to in "${targets[@]}"; do
    [[ -n "$to" && "$to" != "$from" ]] || continue
    cmd_ask --from "$from" "$to" "$q"
    asked=$(( asked + 1 ))
  done
  (( asked > 0 )) || die "pair '$pair' has no ask target other than '$from'"
}

# MULTI-RECIPIENT SEND — the protocol promised it and the transport did not deliver it.
#
# COMMS.md's line protocol defines `to>from` addressing, and every lane writes headers
# like `to>supervisor to>hive to>core`. `fleet send` took ONE recipient. Those header
# lines were BODY TEXT: they routed nothing, and the message reached only the id named
# in the command.
#
# NOTHING REPORTED IT. One arrow line appeared, addressed to the peer actually named,
# and it looked exactly like success. composer found this in its own traffic — its
# urgent "every lane check your parser" correction reached the supervisor ALONE, four
# lanes never saw it — and android then found the same defect across EVERY message it
# sent today: each one opened `>supervisor >hive >core >composer >all` and each one
# was a single `pair-send supervisor`. Its confirmations to hive and core, its
# withdrawal of a null hive was building on, all supervisor-only.
#
# ★ THE SCHEMA INVITED THE ERROR AND THE TRANSPORT COULD NOT REFUSE IT. That is a
# protocol-versus-transport gap, not six lanes making the same mistake — and the
# delivery confirmation was TRUE while the addressing was FICTION, which is why it
# survived a whole session of lanes checking their arrow lines.
#
# Fixed on the transport side: a comma-separated list sends to each id, one delivery
# and one arrow line each. The rule that goes with it, and it is in AGENTS.md now:
# `to>` lines in a body are DOCUMENTATION OF INTENT, NEVER ROUTING. A message is
# delivered to exactly the recipients named in the COMMAND.
cmd_send() {
  _fleet_parse_msg "$@"
  [[ -n "$_F_TO" && -n "$_F_TEXT" ]] || die "usage: fleet send <to>[,<to>...] \"<msg>\" [--from <id>]"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_has_tmux || die "tmux required. Run: sudo apt install tmux"

  local _to_list=() _t
  IFS=',' read -r -a _to_list <<< "$_F_TO"
  # Guard EVERY recipient before delivering to ANY of them, so a rejected id cannot
  # leave a half-sent message: a partial multicast is worse than a refused one,
  # because the sender sees some arrows and reads it as success.
  for _t in "${_to_list[@]}"; do
    _t="${_t#"${_t%%[![:space:]]*}"}"; _t="${_t%"${_t##*[![:space:]]}"}"
    [[ -n "$_t" ]] || die "empty recipient in list '$_F_TO'"
    _fleet_guard_messaging msg "$_F_FROM" "$_t"
  done
  for _t in "${_to_list[@]}"; do
    _t="${_t#"${_t%%[![:space:]]*}"}"; _t="${_t%"${_t##*[![:space:]]}"}"
    _fleet_deliver msg "$_t" "$_F_FROM" "$_F_TEXT"
  done
}

cmd_ask() {
  _fleet_parse_msg "$@"
  [[ -n "$_F_TO" && -n "$_F_TEXT" ]] || die "usage: fleet ask <to> \"<question>\" [--from <id>]"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_has_tmux || die "tmux required. Run: sudo apt install tmux"
  local to="$_F_TO" from="$_F_FROM" q="$_F_TEXT"
  [[ "$to" == "$from" ]] && die "cannot ask yourself ($to)"
  local cap; cap="$(fleet_max_hops)"
  local hop; hop="$(fleet_next_hop "$from")" || {
    fleet_log hop-limit "$to" "from=$from cap=$cap"
    die "hop limit ($cap) reached for this thread — not asking '$to'. Start a fresh thread, or raise [supervisor] max_hops."
  }
  local rel cwd
  if fleet_is_supervisor_id "$to"; then
    cwd="$WORKSPACE"                       # the supervisor lives at the workspace root
  else
    cwd="$(_fleet_id_cwd "$to")"
  fi
  [[ -d "$cwd" ]] || die "target '$to' cwd does not exist: $cwd"
  fleet_tmux_ensure_session
  # A transient window in the target's repo runs the responder: it answers
  # off-thread from provider-native context, then routes the reply back
  # (full → asker's inbox, one-line summary → asker's thread, brief FYI → target's
  # thread). The window closes itself when done.
  # Qualify the empty window component (`session:`): tmux then allocates the next
  # unused index instead of reusing a caller/session-current index inherited via
  # TMUX + TMUX_PANE (which can be occupied by a worker window).
  fleet_tmux new-window -t "$FLEET_TMUX_SESSION:" -n "ask:$to" -c "$cwd" \
    -e "TOOL_ROOT=$TOOL_ROOT" -e "FLEET_WORKSPACE=$WORKSPACE" \
    -e "FLEET_TMUX_SOCKET=$FLEET_TMUX_SOCKET" \
    -e "FLEET_CLAUDE_BIN=${FLEET_CLAUDE_BIN:-claude}" -e "FLEET_CODEX_BIN=${FLEET_CODEX_BIN:-codex}" \
    "$TOOL_ROOT/lib/responder.sh" "$to" "$from" "$q" "$hop"
  fleet_log ask "$to" "from=$from hop=$hop (off-thread responder)"
  info "asked '$to' — an off-thread provider-native context is answering (its live thread is untouched)."
  info "  reply lands in '$from's inbox (fleet inbox $from) + a one-line note in its thread."
}

cmd_broadcast() {
  # --file <path> | --file -  → read the body out of band; see _fleet_parse_msg for why
  # (a message passed as a shell WORD is a shell TOKEN, and an unset $VAR eats a clause
  # silently: exit 0, message delivered, hole in it, nobody can tell).
  local msg="" _b_file=""
  while [[ $# -gt 0 ]]; do case "$1" in
    --file) _b_file="$2"; shift 2 ;;
    *) [[ -z "$msg" ]] && msg="$1"; shift ;;
  esac; done
  if [[ -n "$_b_file" ]]; then
    [[ -n "$msg" ]] && die "give the body EITHER as an argument OR via --file, not both"
    if [[ "$_b_file" == "-" ]]; then msg="$(cat)"
    else [[ -r "$_b_file" ]] || die "--file: cannot read '$_b_file'"; msg="$(cat -- "$_b_file")"; fi
    [[ -n "$msg" ]] || die "--file: '$_b_file' is empty — refusing to broadcast a blank message"
  fi
  [[ -n "$msg" ]] || die "usage: fleet broadcast \"<msg>\" | fleet broadcast --file <path>"
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  local from="${FLEET_CHILD_ID:-supervisor}" c
  _fleet_guard_messaging broadcast "$from"
  for c in "${CHILD_IDS[@]:-}"; do
    [[ -z "$c" || "$c" == "$from" ]] && continue
    fleet_enqueue "$c" "$from" "$msg"; fleet_drain_inbox "$c" >/dev/null || true
    info "→ $c"
  done
}

cmd_inbox() {
  fleet_load_paths
  local id="${1:-${FLEET_CHILD_ID:-}}"
  [[ -z "$id" ]] && die "usage: fleet inbox <id>  (or set FLEET_CHILD_ID)"
  fleet_require_member_id "$id"
  local f; f="$(fleet_inbox_file "$id")" || { info "(no messages for $id)"; return; }
  [[ -f "$f" ]] || { info "(no messages for $id)"; return; }
  # Read under a SHARED flock (same fd/lock-file convention the writers use in
  # comms.sh) so we never dump a half-written line while an enqueue/drain holds
  # the exclusive lock. Degrades gracefully if flock is unavailable.
  exec 9>"$f.lock"; flock -s 9 2>/dev/null || true
  jq -r '"\(.ts|strftime("%H:%M:%S"))  \(if .delivered then "✓" else "•" end) [\(.kind // "msg") from \(.from)] \(.text)"' "$f"
  flock -u 9 2>/dev/null || true; exec 9>&-
}

# --- remote control (Claude Code's /remote-control slash command) -----------
# Enable claude.ai/code + mobile control of a live session by typing the
# /remote-control slash command into it (no relaunch needed).
_rc_members() {
  local only="$1" id
  if [[ -n "$only" ]]; then printf '%s\n' "$only"; return; fi
  for id in $(fleet_state_ids); do fleet_tmux_has_window "$id" 2>/dev/null && printf '%s\n' "$id"; done
}

# report a member's remote-control status: active | -. Reads only the bottom
# status-bar lines (which show "Remote Control active" iff active) — NOT the
# conversation scrollback, where stale "connecting…" lines would mislead.
_rc_status() {
  local bar; bar="$(fleet_tmux capture-pane -t "$FLEET_TMUX_SESSION:$1" -p 2>/dev/null | grep -vE '^\s*$' | tail -2)"
  grep -qi 'Remote Control active' <<<"$bar" && echo "active" || echo "-"
}

# /remote-control is a TOGGLE, so we read each member's current state and only
# send the keystroke when it would move it the way you asked.
#   fleet remote-control [on|off] [id]   (default: on)
cmd_remote_control() {
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  fleet_has_tmux || die "tmux required for remote-control. Run: sudo apt install tmux"
  local mode="on"; case "${1:-}" in on|off) mode="$1"; shift ;; esac
  local only="${1:-}" id st provider acted=0
  while read -r id; do
    [[ -n "$id" ]] || continue
    fleet_tmux_has_window "$id" 2>/dev/null || { warn "$id: no live window"; continue; }
    provider="$(_fleet_id_provider "$id")"
    [[ "$provider" == "claude" ]] || { info "  $id: remote-control unavailable for provider '$provider'"; continue; }
    st="$(_rc_status "$id")"
    if [[ "$mode" == "on" ]]; then
      [[ "$st" == "active" || "$st" == "connecting" ]] && { info "  $id: already $st"; continue; }
      fleet_tmux send-keys -t "$FLEET_TMUX_SESSION:$id" -l "/remote-control $id" 2>/dev/null || continue
    else
      [[ "$st" != "active" && "$st" != "connecting" ]] && { info "  $id: already off"; continue; }
      fleet_tmux send-keys -t "$FLEET_TMUX_SESSION:$id" -l "/remote-control" 2>/dev/null || continue
    fi
    sleep 0.2; fleet_tmux send-keys -t "$FLEET_TMUX_SESSION:$id" Enter 2>/dev/null || continue
    fleet_log remote-control "$id" "$mode"
    info "→ turning remote-control $mode for '$id'"; acted=1
  done < <(_rc_members "$only")
  (( acted )) || { info "(nothing to change)"; return; }
  info "settling…"; sleep 5
  cmd_remote "$only"
  [[ "$mode" == "on" ]] && {
    info ""
    info "Enabled members appear by name in claude.ai/code and the Claude mobile app"
    info "(signed in as you). No URL/ports — it's an outbound connection."
  }
}

cmd_remote() {
  fleet_load_paths; [[ -f "$MANIFEST" ]] && fleet_manifest_load "$MANIFEST"
  local only="${1:-}" id st provider
  printf '%s%-14s %-8s %s%s\n' "$c_bold" "MEMBER" "PROVIDER" "REMOTE CONTROL" "$c_reset"
  while read -r id; do
    [[ -n "$id" ]] || continue
    provider="$(_fleet_id_provider "$id")"
    if [[ "$provider" == "claude" ]]; then st="$(_rc_status "$id")"
    else st="n/a"; fi
    printf '  %-12s %-8s %s\n' "$id" "$provider" "$st"
  done < <(_rc_members "$only")
}

# ----------------------------------------------------------------------------
main() {
  fleet_require_jq
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    wizard|setup) cmd_wizard "$@" ;;
    init)      cmd_init "$@" ;;
    install-hooks)
      local hook_provider="claude" user_scope=0
      while [[ $# -gt 0 ]]; do
        case "${1:-}" in
          --user) user_scope=1; shift ;;
          --provider) hook_provider="${2:?usage: fleet install-hooks [--provider claude|codex|all] [--user|workspace]}"; shift 2 ;;
          --claude) hook_provider="claude"; shift ;;
          --codex) hook_provider="codex"; shift ;;
          --all) hook_provider="all"; shift ;;
          *) break ;;
        esac
      done
      if [[ "$user_scope" == "1" ]]; then fleet_install_user_hooks_for_provider "$hook_provider"
      else fleet_install_hooks_for_provider "$hook_provider" "${1:-$PWD}"; fi ;;
    install-commands)
      if [[ "${1:-}" == "--user" ]]; then fleet_install_user_commands
      else fleet_install_commands "${1:-$PWD}"; fi ;;
    install-git-hooks) cmd_install_git_hooks "$@" ;;
    install-service) cmd_install_service "$@" ;;
    identity|id) cmd_identity "$@" ;;
    status|ls) cmd_status "$@" ;;
    tokens|load) cmd_tokens "$@" ;;
    compact)   cmd_compact "$@" ;;
    brief)     cmd_brief "$@" ;;
    conflicts) cmd_conflicts "$@" ;;
    tasks)     cmd_tasks "$@" ;;
    logs|log)  cmd_logs "$@" ;;
    up)        cmd_up "$@" ;;
    supervise|supervisor) cmd_supervise "$@" ;;
    order)     cmd_order "$@" ;;
    down)      cmd_down "$@" ;;
    restart)   cmd_restart "$@" ;;
    dispatch)  cmd_dispatch "$@" ;;
    init-repo|repo-init) cmd_init_repo "$@" ;;
    init-resume|resume-init) cmd_init_resume "$@" ;;
    pair)      cmd_pair "$@" ;;
    pairs|pair-status|pair-ls) cmd_pairs "$@" ;;
    handoff)   cmd_handoff "$@" ;;
    failover)  cmd_failover "$@" ;;
    refute|adversary|adversarial) cmd_refute "$@" ;;
    attach)    cmd_attach "$@" ;;
    reap)      cmd_reap "$@" ;;
    doctor)    cmd_doctor "$@" ;;
    remote-control|rc) cmd_remote_control "$@" ;;
    remote)    cmd_remote "$@" ;;
    ask)       cmd_ask "$@" ;;
    send)      cmd_send "$@" ;;
    pair-send|psend) cmd_pair_send "$@" ;;
    pair-ask|pask) cmd_pair_ask "$@" ;;
    broadcast) cmd_broadcast "$@" ;;
    inbox)     cmd_inbox "$@" ;;
    decision)
      case "${1:-}" in
        add|"") shift || true; cmd_decision_add "$@" ;;
        challenge) shift; cmd_decision_challenge "$@" ;;
        revoke) shift; cmd_decision_revoke "$@" ;;
        decide|ratify) shift; cmd_decide "$@" ;;
        *) die "usage: fleet decision {add|challenge|revoke|decide} ..." ;;
      esac ;;
    decisions) cmd_decisions "$@" ;;
    decide)    cmd_decide "$@" ;;
    version|-v|--version) echo "fleet $FLEET_VERSION" ;;
    help|-h|--help) usage ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}
main "$@"
